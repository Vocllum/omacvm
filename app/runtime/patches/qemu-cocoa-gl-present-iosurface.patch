+/* OMACVM_GL_FPS=1: frames shown per second, on stderr. */
+static void cocoa_gl_present_count(void)
+{
+    static int fps_on = -1, frames;
+    static int64_t since;
+
+    if (fps_on < 0) {
+        fps_on = getenv("OMACVM_GL_FPS") != NULL;
+    }
+    if (fps_on) {
+        int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+        frames++;
+        if (now - since >= 1000) {
+            fprintf(stderr, "[cocoa-gl] %d frames/s\n",
+                    (int)(frames * 1000 / (now - since)));
+            frames = 0;
+            since = now;
+        }
+    }
+}
+
 static void cocoa_gl_render(void)
 {
     NSSize size = [cocoaView convertSizeToBacking:[cocoaView frame].size];
@@ -2840,26 +2891,298 @@
     /* Clear dirty flag after render completes to ensure clean handoff */
     gl_dirty = false;
 
-    /* OMACVM_GL_FPS=1: frames shown per second, on stderr. */
-    {
-        static int fps_on = -1, frames;
-        static int64_t since;
-        if (fps_on < 0) {
-            fps_on = getenv("OMACVM_GL_FPS") != NULL;
+    cocoa_gl_present_count();
