+
+/*
+ * IOSurface present: on QEMU's thread (BQL held) the guest's scanout is
+ * drawn into one of three IOSurfaces with a context of its own, and the
+ * window's layer shows that surface. No GL drawing on the main thread, no
+ * BQL there, and Core Animation composites the surface as it is.
+ *
+ * Threads: cocoa_gl_present() runs with the BQL; present_queue waits for
+ * the GPU to finish a surface, then the main queue sets it as the layer's
+ * contents. A surface is reused only once Core Animation is done with it.
+ * OMACVM_GL_PRESENT=layer goes back to the CAOpenGLLayer path.
+ */
+#define PRESENT_SURFACES 3
+
+static int present_mode = -1;          /* 1: IOSurface, 0: CAOpenGLLayer */
+static CGLContextObj present_ctx;      /* QEMU thread: draws the surfaces */
+static CGLContextObj present_wait_ctx; /* present_queue: waits for the GPU */
+static QemuGLShader *present_gls;
+static GLuint present_fbo;
+static IOSurfaceRef present_surf[PRESENT_SURFACES];
+static GLuint present_tex[PRESENT_SURFACES];
+static uint32_t present_w, present_h;
+static unsigned present_next;
+static dispatch_queue_t present_queue;
+static QEMUTimer *present_timer;
+static int64_t present_last_ns;
+static int64_t present_period_ns;
+
+static bool cocoa_gl_present_iosurface_wanted(void)
+{
+    if (present_mode < 0) {
+        const char *m = getenv("OMACVM_GL_PRESENT");
+        present_mode = !(m && !strcmp(m, "layer"));
+    }
+    return present_mode == 1;
+}
+
+static void cocoa_gl_present_timer(void *opaque);
+
+static bool cocoa_gl_present_init(void)
+{
+    CGLPixelFormatObj pf = cocoa_gl_create_cgl_pixel_format(32);
+    CGLContextObj prev = CGLGetCurrentContext();
+
+    if (CGLCreateContext(pf, gl_view_ctx, &present_ctx) != kCGLNoError ||
+        CGLCreateContext(pf, gl_view_ctx, &present_wait_ctx) != kCGLNoError) {
+        CGLDestroyPixelFormat(pf);
+        return false;
+    }
+    CGLDestroyPixelFormat(pf);
+
+    CGLSetCurrentContext(present_ctx);
+    present_gls = qemu_gl_init_shader();
+    glGenFramebuffers(1, &present_fbo);
+    CGLSetCurrentContext(prev);
+
+    present_queue = dispatch_queue_create("org.omacvm.present",
+                                          DISPATCH_QUEUE_SERIAL);
+    present_timer = timer_new_ns(QEMU_CLOCK_REALTIME,
+                                 cocoa_gl_present_timer, NULL);
+    /* At most one frame per refresh of the fastest display. */
+    NSInteger hz = 60;
+    for (NSScreen *screen in [NSScreen screens]) {
+        hz = MAX(hz, [screen maximumFramesPerSecond]);
+    }
+    present_period_ns = NANOSECONDS_PER_SECOND / hz;
+    return true;
+}
+
+static void cocoa_gl_present_free(void)
+{
+    for (int i = 0; i < PRESENT_SURFACES; i++) {
+        if (present_tex[i]) {
+            glDeleteTextures(1, &present_tex[i]);
+            present_tex[i] = 0;
         }
-        if (fps_on) {
-            int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
-            frames++;
-            if (now - since >= 1000) {
-                fprintf(stderr, "[cocoa-gl] %d frames/s\n",
-                        (int)(frames * 1000 / (now - since)));
-                frames = 0;
-                since = now;
-            }
+        if (present_surf[i]) {
+            CFRelease(present_surf[i]);
+            present_surf[i] = NULL;
+        }
+    }
+    present_w = present_h = 0;
+}
+
+/* present_ctx is current. */
+static bool cocoa_gl_present_alloc(uint32_t w, uint32_t h)
+{
+    if (w == present_w && h == present_h && present_surf[0]) {
+        return true;
+    }
+    cocoa_gl_present_free();
+    if (!w || !h || w > 16384 || h > 16384) {
+        return false;
+    }
+
+    NSDictionary *props = @{
+        (id)kIOSurfaceWidth: @(w),
+        (id)kIOSurfaceHeight: @(h),
+        (id)kIOSurfaceBytesPerElement: @4,
+        (id)kIOSurfacePixelFormat: @((uint32_t)'BGRA'),
+    };
+    for (int i = 0; i < PRESENT_SURFACES; i++) {
+        present_surf[i] = IOSurfaceCreate((CFDictionaryRef)props);
+        if (!present_surf[i]) {
+            cocoa_gl_present_free();
+            return false;
+        }
+        glGenTextures(1, &present_tex[i]);
+        glBindTexture(GL_TEXTURE_RECTANGLE, present_tex[i]);
+        if (CGLTexImageIOSurface2D(present_ctx, GL_TEXTURE_RECTANGLE,
+                                   GL_RGBA, w, h, GL_BGRA,
+                                   GL_UNSIGNED_INT_8_8_8_8_REV,
+                                   present_surf[i], 0) != kCGLNoError) {
+            cocoa_gl_present_free();
+            return false;
+        }
+    }
+    glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+    present_w = w;
+    present_h = h;
+    present_next = 0;
+    return true;
+}
+
+/*
+ * OMACVM_GL_DUMP=FILE: a frame shown as a PPM, to check orientation and
+ * colours; written whenever FILE does not exist (delete it for a new one).
+ */
+static void cocoa_gl_present_dump(IOSurfaceRef surf)
+{
+    const char *path = getenv("OMACVM_GL_DUMP");
+    FILE *f;
+
+    if (!path || access(path, F_OK) == 0 || !(f = fopen(path, "wb"))) {
+        return;
+    }
+    IOSurfaceLock(surf, kIOSurfaceLockReadOnly, NULL);
+    size_t w = IOSurfaceGetWidth(surf), h = IOSurfaceGetHeight(surf);
+    size_t stride = IOSurfaceGetBytesPerRow(surf);
+    const uint8_t *base = IOSurfaceGetBaseAddress(surf);
+    fprintf(f, "P6\n%zu %zu\n255\n", w, h);
+    for (size_t y = 0; y < h; y++) {
+        for (size_t x = 0; x < w; x++) {
+            const uint8_t *px = base + y * stride + x * 4;
+            uint8_t rgb[3] = { px[2], px[1], px[0] };
+            fwrite(rgb, 1, 3, f);
+        }
+    }
+    IOSurfaceUnlock(surf, kIOSurfaceLockReadOnly, NULL);
+    fclose(f);
+}
+
+/* QEMU thread, BQL held. Returns false when nothing could be shown. */
+static bool cocoa_gl_present(void)
+{
+    GLuint src;
+    bool flip;
+    uint32_t w, h;
+    GLint filter = qatomic_read(&zoom_interpolation) ? GL_LINEAR : GL_NEAREST;
+
+    if (gl_scanout_borrow) {
+        DisplayGLTexture texture = gl_scanout_borrow(gl_scanout_id);
+        if (!texture.id) {
+            return false;
+        }
+        src = texture.id;
+        w = texture.width;
+        h = texture.height;
+        /* The surface's first row is the top of the window. */
+        flip = !texture.y_0_top;
+    } else if (surface && surface->texture) {
+        src = surface->texture;
+        w = surface_width(surface);
+        h = surface_height(surface);
+        flip = true;
+    } else {
+        return false;
+    }
+
+    CGLContextObj prev = CGLGetCurrentContext();
+    if (prev) {
+        /* What the guest drew must reach the GPU before we read it. */
+        glFlush();
+    }
+    CGLSetCurrentContext(present_ctx);
+
+    if (!cocoa_gl_present_alloc(w, h)) {
+        CGLSetCurrentContext(prev);
+        return false;
+    }
+
+    /* The next surface Core Animation is not showing or reading. */
+    unsigned i;
+    for (i = 0; i < PRESENT_SURFACES; i++) {
+        unsigned n = (present_next + i) % PRESENT_SURFACES;
+        if (!IOSurfaceIsInUse(present_surf[n])) {
+            break;
+        }
+    }
+    if (i == PRESENT_SURFACES) {
+        /* All busy: try again after the next refresh. */
+        CGLSetCurrentContext(prev);
+        gl_dirty = true;
+        timer_mod(present_timer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME) +
+                                 present_period_ns);
+        return true;
+    }
+    unsigned n = (present_next + i) % PRESENT_SURFACES;
+    present_next = (n + 1) % PRESENT_SURFACES;
+
+    glBindFramebuffer(GL_FRAMEBUFFER, present_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, present_tex[n], 0);
+    glViewport(0, 0, w, h);
+    glDisable(GL_BLEND);
+    glDisable(GL_SCISSOR_TEST);
+    /* The guest's alpha means nothing here: the window is opaque. */
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, src);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    qemu_gl_run_texture_blit(present_gls, flip);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    GLsync sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    glFlush();
+    CGLSetCurrentContext(prev);
+    gl_dirty = false;
+
+    IOSurfaceRef surf = present_surf[n];
+    CFRetain(surf);
+    /* Core Animation must not see the surface before the GPU wrote it. */
+    IOSurfaceIncrementUseCount(surf);
+    dispatch_async(present_queue, ^{
+        CGLSetCurrentContext(present_wait_ctx);
+        if (sync) {
+            glClientWaitSync(sync, GL_SYNC_FLUSH_COMMANDS_BIT,
+                             1000 * 1000 * 1000);
+            glDeleteSync(sync);
         }
+        CGLSetCurrentContext(NULL);
+        cocoa_gl_present_dump(surf);
+        dispatch_async(dispatch_get_main_queue(), ^{
+            CALayer *layer = [cocoaView layer];
+            [CATransaction begin];
+            [CATransaction setDisableActions:YES];
+            NSString *f = filter == GL_LINEAR ? kCAFilterLinear : kCAFilterNearest;
+            [layer setMagnificationFilter:f];
+            [layer setMinificationFilter:f];
+            [layer setContents:(id)surf];
+            [CATransaction commit];
+            IOSurfaceDecrementUseCount(surf);
+            CFRelease(surf);
+        });
+    });
+    cocoa_gl_present_count();
+    present_last_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    return true;
+}
+
+/*
+ * QEMU thread, BQL held. The guest may flush far more often than the
+ * display refreshes (a full-screen app scanned out directly): draw at
+ * most one surface per refresh, the newest, when the period is over.
+ */
+static void cocoa_gl_present_request(void)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+
+    gl_dirty = true;
+    if (now - present_last_ns >= present_period_ns) {
+        timer_del(present_timer);
+        cocoa_gl_present();
+    } else if (!timer_pending(present_timer)) {
+        timer_mod(present_timer, present_last_ns + present_period_ns);
     }
 }
 
+static void cocoa_gl_present_timer(void *opaque)
+{
+    if (gl_dirty) {
+        cocoa_gl_present();
+    }
+}
