From: OmacVM
Subject: [PATCH] cocoa: show each guest frame when it is flushed

The GL scanout flush only marked the view dirty; the window redrew on
QEMU's 30 ms GUI refresh tick, so it showed at most 33 frames a second
while Omarchy rendered at 120. Ask Core Animation for a redraw as soon as
the guest flushes (one request in flight at a time).

OMACVM_GL_PRESENT_ON_TICK=1 restores the old behaviour, OMACVM_GL_FPS=1
prints the frames shown per second on stderr. Applies after the
texture-borrowing and GPU-resolution patches.

diff --git a/ui/cocoa.m b/ui/cocoa.m
index abc53b5..8626546 100644
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -138,6 +138,7 @@ @interface QemuCGLLayer : CAOpenGLLayer
 @end
 
 static bool gl_dirty;
+static bool gl_present_pending;
 static uint32_t gl_scanout_id;
 static DisplayGLTextureBorrower gl_scanout_borrow;
 static QEMUGLContext gl_view_ctx;
@@ -2838,6 +2839,25 @@ static void cocoa_gl_render(void)
 
     /* Clear dirty flag after render completes to ensure clean handoff */
     gl_dirty = false;
+
+    /* OMACVM_GL_FPS=1: frames shown per second, on stderr. */
+    {
+        static int fps_on = -1, frames;
+        static int64_t since;
+        if (fps_on < 0) {
+            fps_on = getenv("OMACVM_GL_FPS") != NULL;
+        }
+        if (fps_on) {
+            int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+            frames++;
+            if (now - since >= 1000) {
+                fprintf(stderr, "[cocoa-gl] %d frames/s\n",
+                        (int)(frames * 1000 / (now - since)));
+                frames = 0;
+                since = now;
+            }
+        }
+    }
 }
 
 static void cocoa_gl_refresh(DisplayChangeListener *dcl)
@@ -2898,6 +2918,26 @@ static void cocoa_gl_scanout_flush(DisplayChangeListener *dcl,
 {
     gl_dirty = true;
 
+    /*
+     * Show the guest's frame now, not on the next 30 ms refresh tick:
+     * the window would otherwise update at 33 frames a second at most.
+     * One request at a time; Core Animation draws it with the next frame.
+     */
+    static int on_tick = -1;
+    if (on_tick < 0) {
+        /* OMACVM_GL_PRESENT_ON_TICK=1: the old way, for comparison. */
+        on_tick = getenv("OMACVM_GL_PRESENT_ON_TICK") != NULL;
+    }
+#ifdef CONFIG_EGL
+    if (!egl_surface)
+#endif
+    if (!on_tick && !qatomic_xchg(&gl_present_pending, true)) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            qatomic_set(&gl_present_pending, false);
+            [[cocoaView layer] setNeedsDisplay];
+        });
+    }
+
     cocoa_gl_log("scanout flush region=%ux%u+%u+%u", w, h, x, y);
 }
 
