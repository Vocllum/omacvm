+ * the value as it is (converted to the unsigned type of the same size for a
+ * uint output). */
+static const char *txq_result_cast(const struct dest_info *dinfo, unsigned components)
+{
+   static const char *uint_types[] = { "uint", "uint", "uvec2", "uvec3" };
+   if (!dinfo->dst_is_int)
+      return get_string(INT_BITS_TO_FLOAT);
+   if (dinfo->dstconv != dinfo->udstconv)
+      return "";
+   return uint_types[MIN2(components, 3)];
