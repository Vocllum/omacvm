 #define emit_ucompare(op) emit_buff(&ctx->glsl_strbufs, "%s = %s(uintBitsToFloat(%s(%s(%s(%s), %s(%s))%s) * %s(0xffffffff)));\n", dsts[0], get_string(dinfo.dstconv), get_string(dinfo.udstconv), op, get_string(sinfo.svec4), srcs[0], get_string(sinfo.svec4), srcs[1], writemask, get_string(dinfo.udstconv))
+
+/* Store the integer outputs written through int_out_tmp<first> (see
+ * int_temp): the float temporary's bits, as int or uint. Before the shader
+ * returns and before every vertex a geometry shader emits. Named after the
+ * TGSI register: ctx->outputs is sorted again after the body is written. */
+static void emit_int_output_stores(const struct dump_ctx *ctx,
+                                   struct vrend_glsl_strbufs *glsl_strbufs)
+{
+   static const char comps[] = "xyzw";
+   for (uint32_t i = 0; i < ctx->num_outputs; i++) {
+      const struct vrend_shader_io *output = &ctx->outputs[i];
+      if (!output->int_temp || !output->int_temp_written)
+         continue;
+      bool is_uint = output->type == VEC_UINT;
+      const char *cast = is_uint ? "floatBitsToUint" : "floatBitsToInt";
+      if (output->name == TGSI_SEMANTIC_COLOR) {
+         /* fsout_c<n>, uvec4 or ivec4 like the guest's colour buffer */
+         emit_buff(glsl_strbufs, "%s = %s(int_out_tmp%d);\n", output->glsl_name, cast, output->first);
+      } else if (output->name == TGSI_SEMANTIC_SAMPLEMASK) {
+         /* gl_SampleMask[n] comes from component n */
+         for (int c = 0; c < 4; c++) {
+            if (output->int_temp_written & (1 << c))
+               emit_buff(glsl_strbufs, "%s[%d] = %s(int_out_tmp%d.%c);\n",
+                         output->glsl_name, c, cast, output->first, comps[c]);
+         }
+      } else {
+         /* gl_Layer, gl_ViewportIndex, gl_PrimitiveID, gl_FragStencilRefARB:
+          * one int, from the first component the shader wrote */
+         int c = 0;
+         while (!(output->int_temp_written & (1 << c)))
+            c++;
+         emit_buff(glsl_strbufs, "%s = %s(int_out_tmp%d.%c);\n", output->glsl_name, cast,
+                   output->first, comps[c]);
+      }
+   }
+}
 
