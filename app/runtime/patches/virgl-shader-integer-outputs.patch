+   /* Which components of each output the shader writes, before translating:
+    * integer outputs are stored at every return and emitted vertex, also
+    * those that come before the write in the text (loops). */
+   {
+      struct tgsi_parse_context parse;
+      if (tgsi_parse_init(&parse, tokens) != TGSI_PARSE_OK)
+         goto fail;
+      while (!tgsi_parse_end_of_tokens(&parse)) {
+         tgsi_parse_token(&parse);
+         if (parse.FullToken.Token.Type != TGSI_TOKEN_TYPE_INSTRUCTION)
+            continue;
+         const struct tgsi_full_instruction *inst = &parse.FullToken.FullInstruction;
+         for (unsigned d = 0; d < inst->Instruction.NumDstRegs; d++) {
+            const struct tgsi_dst_register *dst = &inst->Dst[d].Register;
+            if (dst->File == TGSI_FILE_OUTPUT && !dst->Indirect &&
+                (unsigned)dst->Index < ARRAY_SIZE(ctx.output_written_mask))
+               ctx.output_written_mask[dst->Index] |= dst->WriteMask;
+         }
+      }
+      tgsi_parse_free(&parse);
+   }
