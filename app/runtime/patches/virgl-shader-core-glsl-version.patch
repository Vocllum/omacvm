virglrenderer: core profile shaders ask for GLSL 3.30, no extensions that are core

What: on a desktop core profile that supports GLSL 3.30 (macOS: 4.10), every
translated shader is "#version 330" or newer instead of 140/150. "#extension"
lines are left out when the emitted version has the feature in core:
ARB_texture_rectangle and ARB_draw_instanced (1.40), ARB_texture_multisample
(1.50), ARB_shader_bit_encoding and ARB_explicit_attrib_location (3.30).
Why: Apple's core profile refuses floatBitsToInt()/intBitsToFloat() and friends
below 3.30, and many translations use them without setting SHADER_REQ_INTS (e.g.
integer vertex attributes passed on: dEQP-GLES3.functional.shaders.precision.int.*).
It also refuses "#extension GL_ARB_draw_instanced" (Chrome's instanced WebGL
shaders). One refused shader stopped the guest's whole GL context, so every
later draw of that app was black (dEQP-GLES3 in one process: 455/896 pass).
Upstreamable (desktop core profiles only; GLES and compatibility hosts are
unchanged); not sent. Replaces virgl-core-instance-id.patch of gpu-robust (same
loop, ARB_draw_instanced is one of the entries here).
Tests: Tests/virgl/test-core-glsl-shaders.c (generated GLSL compiled by the
Mac's OpenGL; fails without this patch).
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -363,6 +363,24 @@ static const struct vrend_shader_table shader_req_table[] = {
     { SHADER_REQ_EXPLICIT_UNIFORM_LOCATION, "ARB_explicit_uniform_location"},
 };
 
+/* GLSL version in which an extension of shader_req_table became core, or 0.
+ * From that version on the "#extension" line is not needed, and core profiles
+ * that don't list the extension (macOS) refuse it. */
+static int shader_req_core_glsl_ver(uint64_t key)
+{
+   switch (key) {
+   case SHADER_REQ_SAMPLER_RECT:
+   case SHADER_REQ_INSTANCE_ID:
+      return 140;
+   case SHADER_REQ_SAMPLER_MS:
+      return 150;
+   case SHADER_REQ_INTS:
+      return 330;
+   default:
+      return 0;
+   }
+}
+
 enum vrend_type_qualifier {
    TYPE_CONVERSION_NONE = 0,
    FLOAT = 1,
@@ -6331,7 +6349,8 @@ static void emit_header(const struct dump_ctx *ctx, struct vrend_glsl_strbufs *g
           ctx->prog_type == TGSI_PROCESSOR_TESS_EVAL)
          emit_ext(glsl_strbufs, "ARB_tessellation_shader", "require");
 
-      if (ctx->prog_type == TGSI_PROCESSOR_VERTEX && ctx->cfg->use_explicit_locations)
+      if (ctx->prog_type == TGSI_PROCESSOR_VERTEX && ctx->cfg->use_explicit_locations &&
+          ctx->glsl_ver_required < 330)
          emit_ext(glsl_strbufs, "ARB_explicit_attrib_location", "require");
       /* Core GLSL 150 already includes fragment coord layouts; avoid extension require on hosts that omit the ARB string (e.g., macOS core GL). */
       if (ctx->prog_type == TGSI_PROCESSOR_FRAGMENT && fs_emit_layout(ctx) && ctx->glsl_ver_required < 150)
@@ -6352,7 +6371,8 @@ static void emit_header(const struct dump_ctx *ctx, struct vrend_glsl_strbufs *g
       }
 
       for (uint32_t i = 0; i < ARRAY_SIZE(shader_req_table); i++) {
-         if (shader_req_table[i].key == SHADER_REQ_SAMPLER_RECT && ctx->glsl_ver_required >= 140)
+         int core_ver = shader_req_core_glsl_ver(shader_req_table[i].key);
+         if (core_ver && ctx->glsl_ver_required >= core_ver)
             continue;
 
          if (ctx->shader_req_bits & shader_req_table[i].key) {
@@ -8178,6 +8198,12 @@ bool vrend_convert_shader(const struct vrend_context *rctx,
    if (cfg->glsl_version >= 140)
       ctx.glsl_ver_required = require_glsl_ver(&ctx, 140);
 
+   /* Many translations use floatBitsToInt() and friends without setting
+    * SHADER_REQ_INTS. They are core in GLSL 3.30, and a core profile that
+    * supports 3.30 (macOS: 4.10) need not be asked for less. */
+   if (!cfg->use_gles && cfg->use_core_profile && cfg->glsl_version >= 330)
+      ctx.glsl_ver_required = require_glsl_ver(&ctx, 330);
+
    if (ctx.iter.processor.Processor == TGSI_PROCESSOR_GEOMETRY ||
        key->gs_present)
       ctx.glsl_ver_required = require_glsl_ver(&ctx, 140);
