+/* Desktop GLSL version from which an extension is core. From that version on
+ * the "#extension" line is not needed, and core profiles that do not list the
+ * extension (macOS) refuse the shader. One table for every place that asks
+ * for an extension (emit_ext_unless_core()). Only extensions whose GLSL the
+ * translator writes with the core names (not ARB_texture_query_lod: it writes
+ * textureQueryLOD). */
+static const struct {
+   const char *name;
+   int glsl_ver;
+} ext_core_glsl_ver[] = {
+   { "ARB_texture_rectangle", 140 },
+   { "ARB_draw_instanced", 140 },
+   { "ARB_uniform_buffer_object", 140 },
+   { "ARB_texture_multisample", 150 },
+   { "ARB_fragment_coord_conventions", 150 },
+   { "ARB_shader_bit_encoding", 330 },
+   { "ARB_explicit_attrib_location", 330 },
+   { "ARB_texture_cube_map_array", 400 },
+   { "ARB_texture_gather", 400 },
+   { "ARB_gpu_shader5", 400 },
+   { "ARB_gpu_shader_fp64", 400 },
+   { "ARB_sample_shading", 400 },
+   { "ARB_tessellation_shader", 400 },
+   { "ARB_viewport_array", 410 },
+   { "ARB_separate_shader_objects", 410 },
+};
+
+static bool ext_is_core(const struct dump_ctx *ctx, const char *name)
+{
+   if (ctx->cfg->use_gles)
+      return false;
+   for (unsigned i = 0; i < ARRAY_SIZE(ext_core_glsl_ver); i++) {
+      if (!strcmp(name, ext_core_glsl_ver[i].name))
+         return ctx->glsl_ver_required >= ext_core_glsl_ver[i].glsl_ver;
+   }
+   return false;
+}
+
