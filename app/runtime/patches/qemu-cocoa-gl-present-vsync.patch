+        }
         timer_mod(present_timer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME) +
                                  present_period_ns);
         return true;
@@ -3132,7 +3211,13 @@ static bool cocoa_gl_present(void)
     gl_dirty = false;
 
     IOSurfaceRef surf = present_surf[n];
+    double flushed = CACurrentMediaTime();
     CFRetain(surf);
+    if (present_vsync) {
+        os_unfair_lock_lock(&present_lock);
+        present_sync.inflight++;
+        os_unfair_lock_unlock(&present_lock);
+    }
     /* Core Animation must not see the surface before the GPU wrote it. */
     IOSurfaceIncrementUseCount(surf);
     dispatch_async(present_queue, ^{
@@ -3144,6 +3229,10 @@ static bool cocoa_gl_present(void)
         }
         CGLSetCurrentContext(NULL);
         cocoa_gl_present_dump(surf);
+        if (present_vsync) {
+            cocoa_gl_present_queue_frame(surf, filter, flushed);
+            return;
+        }
         dispatch_async(dispatch_get_main_queue(), ^{
             CALayer *layer = [cocoaView layer];
             [CATransaction begin];
@@ -3172,6 +3261,20 @@ static void cocoa_gl_present_request(void)
     int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
 
     gl_dirty = true;
+    if (present_vsync) {
+        int waiting;
+        os_unfair_lock_lock(&present_lock);
+        waiting = present_sync.queued + present_sync.inflight;
+        os_unfair_lock_unlock(&present_lock);
+        /*
+         * A guest that flushes faster than the display refreshes: once the
+         * queue is full, the next tick draws the newest frame (present_bh).
+         */
+        if (waiting < PRESENT_QUEUE) {
+            cocoa_gl_present();
+        }
+        return;
+    }
     if (now - present_last_ns >= present_period_ns) {
         timer_del(present_timer);
         cocoa_gl_present();
@@ -3183,10 +3286,271 @@ static void cocoa_gl_present_request(void)
 static void cocoa_gl_present_timer(void *opaque)
 {
     if (gl_dirty) {
-        cocoa_gl_present();
+        if (present_vsync) {
+            cocoa_gl_present_request();
+        } else {
+            cocoa_gl_present();
+        }
+    }
+}
+
+/* QEMU thread, BQL held: a tick took a frame off the queue. */
+static void cocoa_gl_present_bh(void *opaque)
+{
+    if (gl_dirty) {
+        cocoa_gl_present_request();
+    }
+}
+
+static void surface_put(IOSurfaceRef surf)
+{
+    IOSurfaceDecrementUseCount(surf);
+    CFRelease(surf);
+}
+
+/*
+ * Main thread: the window is on a new screen (or the link is new). The link
+ * follows the view's screen by itself; ask for that screen's full rate
+ * (ProMotion panels otherwise may tick slower; 60, 120, 144 Hz displays).
+ */
+static void cocoa_gl_present_screen_changed(void)
+{
+    if (!present_link) {
+        return;
+    }
+    NSInteger hz = [[[cocoaView window] screen] maximumFramesPerSecond];
+    if (hz <= 0) {
+        hz = 60;
     }
+    [present_link setPreferredFrameRateRange:CAFrameRateRangeMake(hz, hz, hz)];
+    info_report("cocoa: frames paced to the window's display, %ld Hz", (long)hz);
 }
 
+/* Main thread: create the display link and its thread once, then run it. */
+static void cocoa_gl_present_link_start(void)
+{
+    if (!present_link) {
+        present_link_target = [[QemuPresentLink alloc] init];
+        present_link = [[cocoaView displayLinkWithTarget:present_link_target
+                                                selector:@selector(tick:)] retain];
+        cocoa_gl_present_screen_changed();
+
+        __block NSRunLoop *loop = nil;
+        dispatch_semaphore_t started = dispatch_semaphore_create(0);
+        NSThread *thread = [[NSThread alloc] initWithBlock:^{
+            loop = [NSRunLoop currentRunLoop];
+            [loop addPort:[NSMachPort port] forMode:NSDefaultRunLoopMode];
+            dispatch_semaphore_signal(started);
+            [loop run];
+        }];
+        [thread setName:@"org.omacvm.vsync"];
+        [thread setQualityOfService:NSQualityOfServiceUserInteractive];
+        [thread start];
+        dispatch_semaphore_wait(started, DISPATCH_TIME_FOREVER);
+        dispatch_release(started);
+        [present_link addToRunLoop:loop forMode:NSDefaultRunLoopMode];
+    }
+    [present_link setPaused:NO];
+}
+
+/*
+ * present_queue: the GPU finished surf; queue it for the display link.
+ * A frame that comes less than half a refresh after the last queued one
+ * replaces it (the guest flushed twice for one refresh).
+ */
+static void cocoa_gl_present_queue_frame(IOSurfaceRef surf, GLint filter,
+                                         double flushed)
+{
+    double now = CACurrentMediaTime();
+    PresentFrame drop = { 0 };
+    bool wake;
+
+    os_unfair_lock_lock(&present_lock);
+    present_sync.inflight--;
+    PresentFrame *last = present_sync.queued ?
+                         &present_sync.queue[present_sync.queued - 1] : NULL;
+    present_sync.win_arrivals++;
+    if (present_sync.merge && last &&
+        now - last->ready < present_sync.period / 2) {
+        drop = *last;
+        present_sync.queued--;
+        present_sync.merged++;
+    } else if (present_sync.queued == PRESENT_QUEUE) {
+        drop = present_sync.queue[0];
+        memmove(&present_sync.queue[0], &present_sync.queue[1],
+                sizeof(PresentFrame) * (PRESENT_QUEUE - 1));
+        present_sync.queued--;
+        present_sync.dropped++;
+    }
+    present_sync.queue[present_sync.queued++] = (PresentFrame){
+        .surf = surf, .filter = filter, .flushed = flushed, .ready = now,
+    };
+    wake = present_idle_ticks > 30 || !present_link;
+    os_unfair_lock_unlock(&present_lock);
+
+    if (drop.surf) {
+        surface_put(drop.surf);
+    }
+    if (wake) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            cocoa_gl_present_link_start();
+        });
+    }
+}
+
+/*
+ * Commit queue, once per refresh, a little before the vsync: put the oldest
+ * queued frame on the layer. Returns false when nothing has come for a
+ * while (the link may pause).
+ */
+static bool cocoa_gl_present_vsync(double T)
+{
+    PresentFrame show = { 0 }, drop = { 0 };
+    double now = CACurrentMediaTime();
+
+    os_unfair_lock_lock(&present_lock);
+    if (T > 0 && T < 0.1) {
+        present_sync.period = T;
+    }
+    present_sync.ticks++;
+    if (present_sync.queued) {
+        show = present_sync.queue[0];
+        present_sync.queued--;
+        memmove(&present_sync.queue[0], &present_sync.queue[1],
+                sizeof(PresentFrame) * present_sync.queued);
+        present_sync.shown++;
+        present_sync.wait_sum += now - show.flushed;
+        present_sync.win_min = MIN(present_sync.win_min, present_sync.queued);
+        present_idle_ticks = 0;
+    } else {
+        if (present_idle_ticks == 0) {
+            /* A refresh without a new frame right after one with. */
+            present_sync.repeats++;
+            present_sync.win_late++;
+        }
+        present_idle_ticks++;
+    }
+    /*
+     * Once a second: if a frame was left over after every tick and none came
+     * late, the queue holds a refresh of delay the guest's timing does not
+     * need (the guest runs a little faster than the display, or a hiccup
+     * filled it). Skip one frame to get the delay back down.
+     */
+    if (++present_sync.win_ticks >= (T > 0 ? lround(1 / T) : 60)) {
+        if (present_sync.win_min >= 1 && present_sync.win_min < INT_MAX &&
+            !present_sync.win_late && present_sync.queued) {
+            drop = present_sync.queue[0];
+            present_sync.queued--;
+            memmove(&present_sync.queue[0], &present_sync.queue[1],
+                    sizeof(PresentFrame) * present_sync.queued);
+            present_sync.dropped++;
+        }
+        /*
+         * Merge close frames only while the guest draws clearly faster than
+         * the display (e.g. 120 Hz guest, window just moved to a 60 Hz
+         * screen). At the display's own rate two close frames are jitter:
+         * both are real frames, and merging them would skip one.
+         */
+        present_sync.merge =
+            present_sync.win_arrivals > present_sync.win_ticks * 5 / 4;
+        present_sync.win_arrivals = 0;
+        present_sync.win_ticks = 0;
+        present_sync.win_min = INT_MAX;
+        present_sync.win_late = 0;
+    }
+    bool idle = present_idle_ticks > 30;
+    os_unfair_lock_unlock(&present_lock);
+
+    if (drop.surf) {
+        surface_put(drop.surf);
+    }
+    if (show.surf) {
+        CALayer *layer = [cocoaView layer];
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        NSString *f = show.filter == GL_LINEAR ? kCAFilterLinear : kCAFilterNearest;
+        [layer setMagnificationFilter:f];
+        [layer setMinificationFilter:f];
+        [layer setContents:(id)show.surf];
+        [CATransaction commit];
+        surface_put(show.surf);
+        /* The guest may have drawn while the queue was full. */
+        qemu_bh_schedule(present_bh);
+    }
+
+    static int fps_on = -1;
+    static double since;
+    if (fps_on < 0) {
+        fps_on = getenv("OMACVM_GL_FPS") != NULL;
+    }
+    if (fps_on && now - since >= 1.0) {
+        os_unfair_lock_lock(&present_lock);
+        fprintf(stderr, "[cocoa-vsync] %.2f Hz: %u ticks, %u frames shown, "
+                "%u repeats, %u merged, %u dropped, %u no free surface, "
+                "flush to tick %.2f ms\n",
+                T > 0 ? 1.0 / T : 0, present_sync.ticks, present_sync.shown,
+                present_sync.repeats, present_sync.merged, present_sync.dropped,
+                present_sync.busy,
+                present_sync.shown ?
+                present_sync.wait_sum * 1000 / present_sync.shown : 0);
+        present_sync.ticks = present_sync.shown = present_sync.repeats = 0;
+        present_sync.merged = present_sync.dropped = present_sync.busy = 0;
+        present_sync.wait_sum = 0;
+        os_unfair_lock_unlock(&present_lock);
+        since = now;
+    }
+    return !idle;
+}
+
+@implementation QemuPresentLink
+/*
+ * Display link thread, once per refresh of the window's screen. Core
+ * Animation picks up the layer at about the vsync: a frame put on the layer
+ * right at the tick sometimes missed it, so the commit happens a little
+ * before the next vsync instead (OMACVM_GL_LEAD_MS, default 3 ms).
+ */
+- (void)tick:(CADisplayLink *)link
+{
+    static dispatch_queue_t commit_queue;
+    static double lead = -1;
+    static bool idle;
+    double target = [link targetTimestamp];
+    double T = target - [link timestamp];
+
+    if (qatomic_read(&idle)) {
+        /*
+         * Nothing new for a while: stop ticking until the next frame. On the
+         * main thread, like the wake-up in cocoa_gl_present_queue_frame, so
+         * a frame that just came in is never left behind a paused link.
+         */
+        qatomic_set(&idle, false);
+        dispatch_async(dispatch_get_main_queue(), ^{
+            os_unfair_lock_lock(&present_lock);
+            if (!present_sync.queued && !present_sync.inflight &&
+                present_idle_ticks > 30) {
+                [link setPaused:YES];
+            }
+            os_unfair_lock_unlock(&present_lock);
+        });
+        return;
+    }
+    if (!commit_queue) {
+        dispatch_queue_attr_t attr = dispatch_queue_attr_make_with_qos_class(
+            DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INTERACTIVE, 0);
+        commit_queue = dispatch_queue_create("org.omacvm.present.commit", attr);
+        const char *e = getenv("OMACVM_GL_LEAD_MS");
+        lead = (e ? atof(e) : 3.0) / 1000;
+    }
+    double wait = MAX(0, target - MIN(lead, T * 0.75) - CACurrentMediaTime());
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(wait * 1e9)),
+                   commit_queue, ^{
+        if (!cocoa_gl_present_vsync(T)) {
+            qatomic_set(&idle, true);
+        }
+    });
+}
+@end
+
 static void cocoa_gl_refresh(DisplayChangeListener *dcl)
 {
     cocoa_refresh(dcl);
