 static CGLContextObj present_ctx;      /* QEMU thread: draws the surfaces */
@@ -2925,6 +2934,63 @@ static void cocoa_gl_render(void)
 static int64_t present_last_ns;
 static int64_t present_period_ns;
 
+/*
+ * Vsync present (default; OMACVM_GL_VSYNC=0 shows each frame as soon as the
+ * GPU is done, like before). The guest's vblank timer runs at the display's
+ * rate but at its own phase. Shown as soon as they are done, two guest
+ * frames sometimes land in one refresh of the Mac (one is never seen) and
+ * none in the next (a repeat): judder at a steady 120 frames a second.
+ *
+ * Here finished frames wait in a short queue, and once per refresh of the
+ * window's screen, shortly before the vsync, the oldest one goes on the
+ * layer. A frame that arrives late waits for the next refresh instead of
+ * pushing out its neighbour. The queue is a jitter buffer: it keeps the
+ * delay that the guest's timing needs, no more.
+ *
+ * The display link runs on a thread of its own and the commits on a
+ * high-priority queue: the main thread handles events and sometimes ran a
+ * tick milliseconds late, which put two frames into one refresh.
+ *
+ * present_lock guards present_sync; queued frames hold one use count and
+ * one retain each. Times are CACurrentMediaTime() seconds.
+ */
+#define PRESENT_QUEUE 3
+
+@interface QemuPresentLink : NSObject
+- (void)tick:(CADisplayLink *)link;
+@end
+
+typedef struct PresentFrame {
+    IOSurfaceRef surf;
+    GLint filter;
+    double flushed;                     /* reached QEMU's present */
+    double ready;                       /* the GPU finished it */
+} PresentFrame;
+
+static struct {
+    PresentFrame queue[PRESENT_QUEUE];  /* oldest first */
+    int queued;
+    int inflight;                       /* drawn, GPU not done yet */
+    double period;                      /* refresh period of the link's screen */
+    int win_ticks;                      /* trim window: ticks so far, */
+    int win_min;                        /* fewest frames left after a tick, */
+    int win_late;                       /* refreshes that had no frame */
+    int win_arrivals;                   /* frames that came in the window */
+    bool merge;                         /* the guest draws faster than the display */
+    unsigned ticks, shown, repeats, merged, dropped, busy;
+    double wait_sum;
+} present_sync;
+static os_unfair_lock present_lock = OS_UNFAIR_LOCK_INIT;
+static bool present_vsync;
+static QEMUBH *present_bh;
+static CADisplayLink *present_link;     /* created on the main thread */
+static QemuPresentLink *present_link_target;
+static int present_idle_ticks;          /* present_lock; > 30: link paused */
+
+static void cocoa_gl_present_bh(void *opaque);
+static void cocoa_gl_present_queue_frame(IOSurfaceRef surf, GLint filter,
+                                         double flushed);
+
 static bool cocoa_gl_present_iosurface_wanted(void)
 {
     if (present_mode < 0) {
@@ -2963,6 +3029,14 @@ static bool cocoa_gl_present_init(void)
         hz = MAX(hz, [screen maximumFramesPerSecond]);
     }
     present_period_ns = NANOSECONDS_PER_SECOND / hz;
+
+    const char *v = getenv("OMACVM_GL_VSYNC");
+    present_vsync = !(v && !strcmp(v, "0"));
+    if (present_vsync) {
+        present_bh = qemu_bh_new(cocoa_gl_present_bh, NULL);
+    }
+    info_report("cocoa: frames shown %s",
+                present_vsync ? "on the display's refresh" : "when drawn");
     return true;
 }
 
@@ -3100,6 +3174,11 @@ static bool cocoa_gl_present(void)
         /* All busy: try again after the next refresh. */
         CGLSetCurrentContext(prev);
         gl_dirty = true;
+        if (present_vsync) {
