+
+/* Without ARB_framebuffer_no_attachments (macOS) the host GL refuses to draw
+ * or clear into a framebuffer that has no attachments (GL error, which stops
+ * the guest context). The guest has such a framebuffer when all its draw
+ * buffers are GL_NONE: legal, nothing is written, but occlusion queries still
+ * count the fragments. The stand-in is a depth renderbuffer (Apple's GL calls
+ * a framebuffer whose only colour attachment no draw buffer selects
+ * "unsupported"), as large as the viewports (see vrend_hw_size_fb_placeholder),
+ * and while it is attached the depth test stays off, as GL does without a
+ * depth buffer (vrend_hw_emit_dsa). No stencil: the stencil test passes. */
+static void vrend_hw_size_fb_placeholder(struct vrend_sub_context *sub_ctx)
+{
+   /* Every fragment the guest's viewports can make must land in the stand-in.
+    * Grown, never shrunk; at most the largest 2D texture the host allows. */
+   int64_t width = 1, height = 1;
+   for (int i = 0; i < PIPE_MAX_VIEWPORTS; i++) {
+      const struct vrend_viewport *vp = &sub_ctx->vps[i];
+      int64_t y = sub_ctx->viewport_is_negative ? (int64_t)vp->cur_y - vp->height : vp->cur_y;
+      width = MAX2(width, (int64_t)vp->cur_x + vp->width);
+      height = MAX2(height, y + vp->height);
+   }
+   width = MIN2(width, (int64_t)vrend_state.max_texture_2d_size);
+   height = MIN2(height, (int64_t)vrend_state.max_texture_2d_size);
+   if (width <= sub_ctx->fb_placeholder_width && height <= sub_ctx->fb_placeholder_height)
+      return;
+
+   sub_ctx->fb_placeholder_width = MAX2(sub_ctx->fb_placeholder_width, (GLsizei)width);
+   sub_ctx->fb_placeholder_height = MAX2(sub_ctx->fb_placeholder_height, (GLsizei)height);
+   glBindRenderbuffer(GL_RENDERBUFFER, sub_ctx->fb_placeholder_rb);
+   glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT16,
+                         sub_ctx->fb_placeholder_width, sub_ctx->fb_placeholder_height);
+   glBindRenderbuffer(GL_RENDERBUFFER, 0);
+}
+
+static void vrend_hw_set_fb_placeholder(struct vrend_sub_context *sub_ctx)
+{
+   bool needed = !sub_ctx->nr_cbufs && !sub_ctx->zsurf && !has_feature(feat_fb_no_attach);
+
+   if (needed == sub_ctx->fb_placeholder_attached)
+      return;
+
+   sub_ctx->fb_placeholder_attached = needed;
+   if (needed) {
+      if (!sub_ctx->fb_placeholder_rb)
+         glGenRenderbuffers(1, &sub_ctx->fb_placeholder_rb);
+      vrend_hw_size_fb_placeholder(sub_ctx);
+      glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER,
+                                sub_ctx->fb_placeholder_rb);
+   } else {
+      /* Unless a depth buffer of the guest has replaced it already. */
+      GLint type = GL_NONE, name = 0;
+      glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                                            GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+      if (type == GL_RENDERBUFFER)
+         glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                                               GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+      if (type == GL_RENDERBUFFER && (GLuint)name == sub_ctx->fb_placeholder_rb)
+         glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, 0);
    }
+   /* the guest's depth test is off while the stand-in is there, back after */
+   vrend_hw_emit_dsa(sub_ctx);
 }
 
