+
+#define INTRO_END     2.4   /* s: the last movement; the logo holds after it */
+#define INTRO_FLIGHT  0.8   /* s a cell flies */
+#define INTRO_SHIFT   2.5   /* cells OMACVM sits right of the logo (76 vs 81 wide) */
+#define INTRO_MAX     (SPLASH_ROWS * MORPH_KEEP_COLS + MORPH_PARTS)
+/* The preview's frame, 1280 x 720 at 10 pixels a cell with the logo in the
+ * middle, is the window: its glow is worked out in those pixels. */
+#define INTRO_W       1280
+#define INTRO_H       720
+#define INTRO_PX      10.0
+#define INTRO_LOGO_X  235.0
+#define INTRO_LOGO_Y  265.0
+#define INTRO_BG_W    640   /* the glow image: half the preview, scaled up */
+#define INTRO_BG_H    360
+
+/* A cell in logo cells (x right, y down from the logo's top left). rest: not
+ * moving, so its edges go on whole pixels exactly as the GL splash's. */
+typedef struct {
+    float x, y, size;
+    bool rest;
+} IntroCell;
+
+static double intro_clamp(double v)
+{
+    return v < 0 ? 0 : v > 1 ? 1 : v;
+}
+
+static double intro_ease(double p)   /* cubic in and out */
+{
+    p = intro_clamp(p);
+    return p < 0.5 ? 4 * p * p * p : 1 - pow(-2 * p + 2, 3) / 2;
+}
+
+static double intro_pulse(double t, double at, double width)
+{
+    double d = fabs(t - at) / width;
+    return d >= 1 ? 0 : 0.5 + 0.5 * cos(M_PI * d);
+}
+
+/* The cells at t seconds into the animation (out: INTRO_MAX), and how strong
+ * the glow is then. */
+static int omacvm_intro_cells(double t, IntroCell *out, double *glow)
+{
+    double drift = intro_ease((t - 0.6) / 1.5), flying = 0;
+    int n = 0;
+
+    for (int r = 0; r < SPLASH_ROWS; r++) {
+        for (int c = 0; c < MORPH_KEEP_COLS; c++) {
+            if (omacvm_splash_cells[r][c] == '#') {
+                out[n++] = (IntroCell){ c + INTRO_SHIFT * (1 - drift), r, 1,
+                                        drift <= 0 || drift >= 1 };
+            }
+        }
+    }
+    for (int i = 0; i < MORPH_PARTS; i++) {
+        const float *p = omacvm_morph_parts[i];
+        double e = intro_ease((t - p[4]) / INTRO_FLIGHT);
+        double bump = sin(M_PI * e), size = 1 - 0.55 * bump, off = (1 - size) / 2;
+        bool rest = e <= 0 || e >= 1;
+
+        if (rest) {
+            bump = 0;
+            size = 1;
+            off = 0;
+        }
+        flying = fmax(flying, bump);
+        out[n++] = (IntroCell){ p[0] + (p[2] - p[0]) * e + off,
+                                p[1] + (p[3] - p[1]) * e + p[5] * bump + off,
+                                size, rest };
+    }
+    *glow = 0.35 * flying + 0.5 * intro_pulse(t, 2.05, 0.35);
+    return n;
+}
+
+/*
+ * Where the logo goes in a w x h pixel view, as omacvm_splash_draw() puts it
+ * for a fw x fh firmware frame: cells of SPLASH_CELL frame pixels, the logo
+ * lw x lh in the middle.
+ */
+typedef struct {
+    double left, top, sx, sy;   /* pixels, from the top left; per cell */
+} IntroGeom;
+
+static IntroGeom omacvm_intro_geom(int w, int h, int fw, int fh)
+{
+    double cw = (double)w * SPLASH_CELL / fw, ch = (double)h * SPLASH_CELL / fh;
+    int lw = MAX(1, (int)lround(SPLASH_COLS * cw));
+    int lh = MAX(1, (int)lround(SPLASH_ROWS * ch));
+    int bottom = (h - lh) / 2;   /* GL's viewport, from the bottom */
+
+    return (IntroGeom){ (w - lw) / 2, h - bottom - lh,
+                        (double)lw / SPLASH_COLS, (double)lh / SPLASH_ROWS };
+}
+
+/* A cell's edges in pixels (x0, y0, x1, y1 from the top left). Resting cells
+ * end where GL's nearest sampling of the 81 x 19 texture ends them. */
+static void omacvm_intro_rect(const IntroGeom *g, const IntroCell *c, double e[4])
+{
+    e[0] = g->left + c->x * g->sx;
+    e[1] = g->top + c->y * g->sy;
+    e[2] = g->left + (c->x + c->size) * g->sx;
+    e[3] = g->top + (c->y + c->size) * g->sy;
+    if (c->rest) {
+        for (int k = 0; k < 4; k++) {
+            e[k] = ceil(e[k] - 0.5);
+        }
+    }
+}
+
+/*
+ * Pillow's resampling weights (the preview was made with Pillow's resize):
+ * for each output pixel the first input and its weights (at most kmax).
+ */
+enum { INTRO_BOX, INTRO_BILINEAR, INTRO_BICUBIC };
+
+typedef struct {
+    int n_out, kmax;
+    int *first, *count;
+    double *w;
+} IntroResample;
+
+static double intro_filter(int kind, double x)
+{
+    x = fabs(x);
+    switch (kind) {
+    case INTRO_BOX:
+        return 1;   /* the window is exactly the box */
+    case INTRO_BILINEAR:
+        return x < 1 ? 1 - x : 0;
+    default:        /* bicubic, a = -0.5 */
+        if (x < 1) {
+            return (1.5 * x - 2.5) * x * x + 1;
+        }
+        return x < 2 ? ((-0.5 * x + 2.5) * x - 4) * x + 2 : 0;
+    }
+}
+
+static void intro_resample_init(IntroResample *r, int in, int out, int kind)
+{
+    static const double support[] = { 0.5, 1, 2 };
+    double scale = (double)in / out, fscale = MAX(scale, 1.0);
+    double sup = support[kind] * fscale;
+
+    r->n_out = out;
+    r->kmax = (int)ceil(sup) * 2 + 1;
+    r->first = g_new0(int, out);
+    r->count = g_new0(int, out);
+    r->w = g_new0(double, out * r->kmax);
+    for (int o = 0; o < out; o++) {
+        double center = (o + 0.5) * scale, sum = 0;
+        int lo = MAX(0, (int)(center - sup + 0.5));
+        int hi = MIN(in, (int)(center + sup + 0.5));
+        double *w = r->w + o * r->kmax;
+
+        if (kind == INTRO_BOX) {
+            /* Pillow's box: inside (-0.5, 0.5] of the scaled distance. */
+            for (int i = lo; i < hi; i++) {
+                double x = (i - center + 0.5) / fscale;
+                w[i - lo] = x > -0.5 && x <= 0.5;
+                sum += w[i - lo];
+            }
+        } else {
+            for (int i = lo; i < hi; i++) {
+                w[i - lo] = intro_filter(kind, (i - center + 0.5) / fscale);
+                sum += w[i - lo];
+            }
+        }
+        for (int i = lo; i < hi && sum != 0; i++) {
+            w[i - lo] /= sum;
+        }
+        r->first[o] = lo;
+        r->count[o] = hi - lo;
+    }
+}
+
+/* dst[y][x] for an image of `lines` rows: along a row (stride 1) or down a
+ * column (step = the row length). */
+static void intro_resample_run(const IntroResample *r, const float *src, float *dst,
+                               int lines, int in_step, int in_line, int out_step,
+                               int out_line)
+{
+    for (int l = 0; l < lines; l++) {
+        for (int o = 0; o < r->n_out; o++) {
+            const double *w = r->w + o * r->kmax;
+            double acc = 0;
+
+            for (int k = 0; k < r->count[o]; k++) {
+                acc += w[k] * src[l * in_line + (r->first[o] + k) * in_step];
+            }
+            dst[l * out_line + o * out_step] = acc;
+        }
+    }
+}
+
+/*
+ * The background with the glow, INTRO_BG_W x INTRO_BG_H RGBA (bytes R, G, B,
+ * A): Omarchy's background plus the green, 0.6 x glow x a blur of the cells.
+ * The blur is the preview's: the cells' cover in 8 x 8 pixel blocks, scaled
+ * up 4x (bilinear), down 8x (box), then up again (bicubic).
+ */
+static void omacvm_intro_background(const IntroCell *cells, int n, double glow,
+                                    uint8_t *rgba)
+{
+    enum { SW = INTRO_W / 8, SH = INTRO_H / 8, BW = INTRO_W / 2, BH = INTRO_H / 2,
+           KW = INTRO_W / 16, KH = INTRO_H / 16 };
+    static IntroResample up_x, up_y, box_x, box_y, out_x, out_y;
+    static float small[SH * SW], tmp1[SH * BW], big[BH * BW], tmp2[BH * KW];
+    static float k[KH * KW], tmp3[KH * INTRO_BG_W], glow_px[INTRO_BG_H * INTRO_BG_W];
+    const double fg[3] = { 0xa8, 0xcd, 0x76 }, bg[3] = { 0x1a, 0x1b, 0x26 };
+
+    if (glow <= 0) {
+        for (int i = 0; i < INTRO_BG_W * INTRO_BG_H; i++) {
+            uint8_t *p = rgba + i * 4;
+            p[0] = bg[0], p[1] = bg[1], p[2] = bg[2], p[3] = 255;
+        }
+        return;
+    }
+    if (!up_x.first) {
+        intro_resample_init(&up_x, SW, BW, INTRO_BILINEAR);
+        intro_resample_init(&up_y, SH, BH, INTRO_BILINEAR);
+        intro_resample_init(&box_x, BW, KW, INTRO_BOX);
+        intro_resample_init(&box_y, BH, KH, INTRO_BOX);
+        intro_resample_init(&out_x, KW, INTRO_BG_W, INTRO_BICUBIC);
+        intro_resample_init(&out_y, KH, INTRO_BG_H, INTRO_BICUBIC);
+    }
+    /* Each cell's area in each 8 x 8 block (the preview adds overlaps up). */
+    memset(small, 0, sizeof(small));
+    for (int i = 0; i < n; i++) {
+        double x0 = INTRO_LOGO_X + cells[i].x * INTRO_PX;
+        double y0 = INTRO_LOGO_Y + cells[i].y * INTRO_PX;
+        double x1 = fmin(x0 + cells[i].size * INTRO_PX, INTRO_W);
+        double y1 = fmin(y0 + cells[i].size * INTRO_PX, INTRO_H);
+
+        x0 = fmax(x0, 0);
+        y0 = fmax(y0, 0);
+        for (int by = (int)(y0 / 8); by < SH && by * 8 < y1; by++) {
+            double h = fmin(y1, by * 8 + 8) - fmax(y0, by * 8);
+            for (int bx = (int)(x0 / 8); bx < SW && bx * 8 < x1; bx++) {
+                double w = fmin(x1, bx * 8 + 8) - fmax(x0, bx * 8);
+                if (w > 0 && h > 0) {
+                    small[by * SW + bx] += w * h / 64;
+                }
+            }
+        }
+    }
+    /* Pillow: across first, then down. */
+    intro_resample_run(&up_x, small, tmp1, SH, 1, SW, 1, BW);
+    intro_resample_run(&up_y, tmp1, big, BW, BW, 1, BW, 1);
+    intro_resample_run(&box_x, big, tmp2, BH, 1, BW, 1, KW);
+    intro_resample_run(&box_y, tmp2, k, KW, KW, 1, KW, 1);
+    intro_resample_run(&out_x, k, tmp3, KH, 1, KW, 1, INTRO_BG_W);
+    intro_resample_run(&out_y, tmp3, glow_px, INTRO_BG_W, INTRO_BG_W, 1, INTRO_BG_W, 1);
+    for (int i = 0; i < INTRO_BG_W * INTRO_BG_H; i++) {
+        double a = 0.6 * glow * intro_clamp(glow_px[i]);
+        uint8_t *p = rgba + i * 4;
+
+        for (int c = 0; c < 3; c++) {
+            p[c] = (uint8_t)fmin(255, bg[c] + (fg[c] - bg[c]) * a + 0.5);
+        }
+        p[3] = 255;
+    }
+}
+
+#endif
