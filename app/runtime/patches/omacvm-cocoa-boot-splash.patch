+/*
+ * OmacVM boot splash. Until the guest shows a picture on an output, and when
+ * it switches the output off again (a reboot), the window shows Omarchy's
+ * logo where the firmware draws it, not QEMU's "Display output is not
+ * active." The firmware's frame (the logo 1215 x 285 in the middle) is
+ * stretched to the window, so the logo takes the same place here and does
+ * not move at the hand-over. The firmware draws at the size virtio-gpu
+ * reports: 1920 x 1080 (the launcher's xres/yres) on a cold start, after a
+ * reboot the window's own, as the guest did before; so the frame is taken to
+ * be as big as the last picture the guest showed. Outputs the firmware never
+ * draws on (the other displays) get square cells at their own size, on
+ * Omarchy's background like the start animation (below), as nothing of the
+ * firmware's black comes before or after it there.
+ *
+ * When the guest has shown nothing of its own OMACVM_SPLASH_HINT_SECONDS
+ * (90) of running time after it started, a line under the logo says so and
+ * where the logs are, and qemu.log gets a warning. OMACVM_BOOT_SPLASH=0:
+ * QEMU's text, as before.
+ *
+ * Threads: the state below is used with the BQL (QEMU's thread, and the
+ * layers' draws on the main thread take it); the hint label is main thread.
+ */
+#include "ui/omacvm-splash.h"   /* the logo's cells, the animation's core */
+
+static int omacvm_splash_on = -1;       /* OMACVM_BOOT_SPLASH */
+static bool omacvm_intro_told;          /* the start animation knows the guest drew */
+static GLuint omacvm_splash_tex[2];     /* on black, on navy; gl_view_ctx's group */
+static bool omacvm_guest_drew;          /* a GL scanout since the last reset */
+static int omacvm_frame_w = 1920;       /* the last picture of the guest's */
+static int omacvm_frame_h = 1080;
+static bool omacvm_splash_hint_up;
+static QEMUTimer *omacvm_splash_timer;
+static NSTextField *omacvm_splash_hint; /* main thread */
+
+static bool omacvm_splash_enabled(void)
+{
+    if (omacvm_splash_on < 0) {
+        const char *v = getenv("OMACVM_BOOT_SPLASH");
+        omacvm_splash_on = !(v && !strcmp(v, "0"));
+        info_report("cocoa: boot splash %s",
+                    omacvm_splash_on ? "on" : "off (OMACVM_BOOT_SPLASH=0)");
+    }
+    return omacvm_splash_on;
+}
+
+/* An output without a picture of the guest's: none yet, or switched off. */
+static bool omacvm_splash_wanted(DisplayGLTextureBorrower borrow,
+                                 DisplaySurface *s)
+{
+#ifdef CONFIG_EGL
+    if (egl_surface) {
+        return false;   /* the logo's texture is in the CGL contexts */
+    }
+#endif
+    return !borrow && (!s || surface_is_placeholder(s)) &&
+           omacvm_splash_enabled();
+}
+
+/* With the BQL: the size of the frame the firmware would show on con. */
+static void omacvm_splash_frame(QemuConsole *con, int *fw, int *fh)
+{
+    const QemuUIInfo *info = con ? qemu_console_get_ui_info(con) : NULL;
+
+    *fw = omacvm_frame_w;
+    *fh = omacvm_frame_h;
+    if (con != dcl.con && info && info->width && info->height) {
+        *fw = info->width;
+        *fh = info->height;
+    }
+}
+
+/*
+ * With the BQL, in a CGL context that shares gl_view_ctx's objects: a w x h
+ * pixel output showing con.
+ */
+static void omacvm_splash_draw(QemuConsole *con, int w, int h, bool square)
+{
+    int fw, fh;
+    /* Black as the firmware's frame; the other displays Omarchy's background. */
+    uint32_t bg = square ? SPLASH_NAVY : 0;
+
+    glClearColor((bg >> 16) / 255.0, ((bg >> 8) & 0xff) / 255.0, (bg & 0xff) / 255.0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (!omacvm_splash_tex[square]) {
+        static uint32_t px[SPLASH_ROWS * SPLASH_COLS];
+        for (int r = 0; r < SPLASH_ROWS; r++) {
+            for (int c = 0; c < SPLASH_COLS; c++) {
+                px[r * SPLASH_COLS + c] = 0xff000000 |
+                    (omacvm_splash_cells[r][c] == '#' ? SPLASH_GREEN : bg);
+            }
+        }
+        glGenTextures(1, &omacvm_splash_tex[square]);
+        glBindTexture(GL_TEXTURE_2D, omacvm_splash_tex[square]);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, SPLASH_COLS, SPLASH_ROWS, 0,
+                     GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, px);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+    /* One cell: SPLASH_CELL x SPLASH_CELL pixels of the firmware's frame. */
+    omacvm_splash_frame(con, &fw, &fh);
+    double cw = (double)w * SPLASH_CELL / fw, ch = (double)h * SPLASH_CELL / fh;
+    if (square) {
+        cw = ch = MIN(cw, ch);
+    }
+    int lw = MAX(1, (int)lround(SPLASH_COLS * cw));
+    int lh = MAX(1, (int)lround(SPLASH_ROWS * ch));
+
+    glViewport((w - lw) / 2, (h - lh) / 2, lw, lh);
+    glBindTexture(GL_TEXTURE_2D, omacvm_splash_tex[square]);
+    /* Sharp cells, whatever the zoom filter. */
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    qemu_gl_run_texture_blit(dgc.gls, false);
+    glViewport(0, 0, w, h);
+}
+
+/* Main thread: the hint under the logo of the main window (fh: frame height). */
+static void omacvm_splash_hint_show(bool show, int fh)
+{
+    if (!show) {
+        [omacvm_splash_hint removeFromSuperview];
+        return;
+    }
+    if (!omacvm_splash_hint) {
+        const char *logs = getenv("OMACVM_LOGS");
+        NSString *text = logs && *logs ?
+            [NSString stringWithFormat:@"Omarchy is taking long to start. Its logs: %@",
+             [[NSString stringWithUTF8String:logs] stringByAbbreviatingWithTildeInPath]] :
+            @"Omarchy is taking long to start. Its logs are in the VM's folder.";
+        omacvm_splash_hint = [[NSTextField labelWithString:text] retain];
+        [omacvm_splash_hint setFont:[NSFont monospacedSystemFontOfSize:13
+                                                                weight:NSFontWeightRegular]];
+        [omacvm_splash_hint setTextColor:[NSColor colorWithSRGBRed:0.66 green:0.69
+                                                              blue:0.84 alpha:1]];
+        [omacvm_splash_hint sizeToFit];
+        [omacvm_splash_hint setAutoresizingMask:NSViewMinXMargin | NSViewMaxXMargin |
+                                                NSViewMinYMargin | NSViewMaxYMargin];
+    }
+    NSRect b = [cocoaView bounds];
+    NSSize size = [omacvm_splash_hint frame].size;
+    /* Under the logo (19 cells of the frame's rows, in the middle). */
+    const int lh = SPLASH_ROWS * SPLASH_CELL;
+    CGFloat y = b.size.height / 2 - b.size.height * lh / MAX(fh, lh) / 2 - 32 - size.height;
+    [omacvm_splash_hint setFrame:NSMakeRect(floor((b.size.width - size.width) / 2),
+                                            floor(MAX(8, y)), size.width, size.height)];
+    if (![omacvm_splash_hint superview]) {
+        [cocoaView addSubview:omacvm_splash_hint];
+    }
+}
+
+static int omacvm_splash_hint_seconds(void)
+{
+    static int seconds;
+    if (!seconds) {
+        const char *v = getenv("OMACVM_SPLASH_HINT_SECONDS");
+        seconds = v && atoi(v) > 0 ? MIN(atoi(v), 3600) : 90;
+    }
+    return seconds;
+}
+
+/* QEMU's thread, BQL: the guest has run that long and shows nothing yet. */
+static void omacvm_splash_hint_timer(void *opaque)
+{
+    if (omacvm_guest_drew || !omacvm_splash_wanted(gl_scanout_borrow, surface)) {
+        return;
+    }
+    int fw, fh;
+
+    omacvm_splash_frame(dcl.con, &fw, &fh);
+    omacvm_splash_hint_up = true;
+    warn_report("cocoa: no picture from the guest %d s after it started",
+                omacvm_splash_hint_seconds());
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_splash_hint_show(true, fh);
+    });
+}
+
+static void omacvm_intro_guest_drew(void);
+
+/* QEMU's thread, BQL: the main output changed. */
+static void omacvm_splash_update(void)
+{
+    if (gl_scanout_borrow) {
+        omacvm_guest_drew = true;
+    }
+    if (!omacvm_intro_told &&
+        (gl_scanout_borrow || (surface && !surface_is_placeholder(surface)))) {
+        /* The guest's first picture: the start animation hands over. */
+        omacvm_intro_told = true;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            omacvm_intro_guest_drew();
+        });
+    }
+    if (surface && !surface_is_placeholder(surface)) {
+        omacvm_frame_w = surface_width(surface);
+        omacvm_frame_h = surface_height(surface);
+    }
+    if (!omacvm_guest_drew && omacvm_splash_wanted(gl_scanout_borrow, surface)) {
+        /* Guest time: a paused VM is not slow to start. */
+        if (!omacvm_splash_timer) {
+            omacvm_splash_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                               omacvm_splash_hint_timer, NULL);
+        }
+        if (!omacvm_splash_hint_up && !timer_pending(omacvm_splash_timer)) {
+            timer_mod(omacvm_splash_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                                           omacvm_splash_hint_seconds() * 1000LL);
+        }
+        return;
+    }
+    if (omacvm_splash_timer) {
+        timer_del(omacvm_splash_timer);
+    }
+    if (omacvm_splash_hint_up) {
+        omacvm_splash_hint_up = false;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            omacvm_splash_hint_show(false, 0);
+        });
+    }
+}
+
+/* A guest reset starts over: the hint counts again from the next splash. */
+static void omacvm_splash_reset(void *opaque)
+{
+    omacvm_guest_drew = false;
+}
+
+/*
+ * OmacVM start animation: when the window opens, OMACVM turns into Omarchy's
+ * logo (O, M and A stay, the cells of C, V and M fly and land as R, C, H and
+ * Y; 2.4 s), Omarchy green on Omarchy's background. Then the logo holds until
+ * the guest shows its first picture (the firmware's, the same logo in the
+ * same place) and fades into it. This is the preview the user picked
+ * (a-pixel-morph.mp4, made by render.py of tracks/boot-splash/anim), drawn
+ * natively: the cells are a Core Animation shape layer, sharp at any size,
+ * and the soft glow is a small image under them, computed as the preview did.
+ *
+ * The guest is never held up: this is only drawing over the window. If the
+ * guest shows a picture before the animation ends, the rest plays within
+ * INTRO_RUSH s and then fades: cutting away mid-flight would leave half-made
+ * letters, and the guest's first picture is that same logo anyway.
+ * Reduce motion (or OMACVM_SPLASH_ANIMATION=0): the logo without the morph.
+ * Only the main window animates; the other displays show the still logo.
+ *
+ * Threads: all of it runs on the main thread (a CADisplayLink drives the
+ * frames); QEMU's thread only says when the guest drew (dispatch_async).
+ * The core (the cells at a time, where they go in the window, the glow) is
+ * in ui/omacvm-splash.h: Tests/display/test-boot-splash-morph.c builds and
+ * checks it on its own.
+ */
+
+static void omacvm_splash_colour(uint32_t rgb, CGFloat *c)
+{
+    c[0] = (rgb >> 16) / 255.0;
+    c[1] = ((rgb >> 8) & 0xff) / 255.0;
+    c[2] = (rgb & 0xff) / 255.0;
+    c[3] = 1;
+}
+
+@interface OmacVMIntroLayer : CALayer
+- (id)initWithFrameWidth:(int)fw height:(int)fh still:(BOOL)still;
+- (void)play;
+- (void)guestDrew;
+@end
+
+static OmacVMIntroLayer *omacvm_intro;   /* main thread; nil once handed over */
+
+#define INTRO_RUSH 0.35   /* s: the rest of the animation once the guest drew */
+#define INTRO_WAIT 0.2    /* s the guest's first picture shows under the logo first */
+#define INTRO_FADE 0.35   /* s */
+
+@implementation OmacVMIntroLayer {
+    CAShapeLayer *cells;
+    CADisplayLink *link;
+    CGColorSpaceRef space;
+    int fw, fh;                 /* the firmware's frame */
+    double t;                   /* where the animation is (s) */
+    CFTimeInterval start;       /* of the first frame; 0 before */
+    CFTimeInterval drew_at;     /* when the guest drew; 0 before */
+    double rush_from, rush_rate;
+    double drew_t;              /* t when the guest drew */
+    bool fading;
+    IntroCell buf[INTRO_MAX];
+    uint8_t bg[INTRO_BG_W * INTRO_BG_H * 4];
+}
+
+- (id)initWithFrameWidth:(int)w height:(int)h still:(BOOL)still
+{
+    self = [super init];
+    if (self) {
+        CGFloat c[4];
+        NSDictionary *none = @{ @"path": [NSNull null], @"bounds": [NSNull null],
+                                @"position": [NSNull null], @"contents": [NSNull null],
+                                @"contentsScale": [NSNull null],
+                                @"backgroundColor": [NSNull null] };
+
+        fw = w;
+        fh = h;
+        t = still ? INTRO_END : 0;
+        /* Like the cursor's image: sRGB, the colours of the preview. */
+        space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+        [self setActions:none];
+        /* Under QEMU's labels (pause, the slow-start hint) and the cursor. */
+        [self setZPosition:-1];
+        [self setAutoresizingMask:kCALayerWidthSizable | kCALayerHeightSizable];
+        [self setContentsGravity:kCAGravityResize];
+        [self setMagnificationFilter:kCAFilterLinear];
+        omacvm_splash_colour(SPLASH_NAVY, c);
+        CGColorRef navy = CGColorCreate(space, c);
+        [self setBackgroundColor:navy];
+        CGColorRelease(navy);
+
+        cells = [[CAShapeLayer alloc] init];
+        [cells setActions:none];
+        omacvm_splash_colour(SPLASH_GREEN, c);
+        CGColorRef green = CGColorCreate(space, c);
+        [cells setFillColor:green];
+        CGColorRelease(green);
+        [cells setAutoresizingMask:kCALayerWidthSizable | kCALayerHeightSizable];
+        [self addSublayer:cells];
+        /* Moved to a display with another scale: draw sharp there. */
+        [[NSNotificationCenter defaultCenter]
+            addObserver:self selector:@selector(render)
+                   name:NSWindowDidChangeBackingPropertiesNotification
+                 object:[cocoaView window]];
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    [[NSNotificationCenter defaultCenter] removeObserver:self];
+    [cells release];
+    CGColorSpaceRelease(space);
+    [super dealloc];
+}
+
+/* The frame at t, at the layer's size now. */
+- (void)render
+{
+    CGRect b = [self bounds];
+    CGFloat scale = [[cocoaView window] backingScaleFactor];
+    double glow;
+    int n = omacvm_intro_cells(t, buf, &glow);
+    int w = (int)(b.size.width * scale), h = (int)(b.size.height * scale);
+
+    if (w < 1 || h < 1 || scale <= 0) {
+        return;
+    }
+    IntroGeom g = omacvm_intro_geom(w, h, fw, fh);
+    CGMutablePathRef path = CGPathCreateMutable();
+    for (int i = 0; i < n; i++) {
+        double e[4];
+        omacvm_intro_rect(&g, &buf[i], e);
+        /* The layer counts from the bottom, in points. */
+        CGPathAddRect(path, NULL, CGRectMake(e[0] / scale, (h - e[3]) / scale,
+                                             (e[2] - e[0]) / scale, (e[3] - e[1]) / scale));
+    }
+
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    [cells setFrame:b];
+    [cells setContentsScale:scale];
+    [cells setPath:path];
+    if (glow > 0) {
+        omacvm_intro_background(buf, n, glow, bg);
+        CFDataRef bytes = CFDataCreate(NULL, bg, sizeof(bg));
+        CGDataProviderRef data = CGDataProviderCreateWithCFData(bytes);
+        CGImageRef image = CGImageCreate(INTRO_BG_W, INTRO_BG_H, 8, 32, INTRO_BG_W * 4,
+                                         space, (CGBitmapInfo)kCGImageAlphaNoneSkipLast,
+                                         data, NULL,
+                                         true, kCGRenderingIntentDefault);
+        [self setContents:(id)image];
+        CGImageRelease(image);
+        CGDataProviderRelease(data);
+        CFRelease(bytes);
+    } else {
+        [self setContents:nil];
+    }
+    [CATransaction commit];
+    CGPathRelease(path);
+}
+
+- (void)layoutSublayers
+{
+    [super layoutSublayers];
+    [self render];
+}
+
+- (void)play
+{
+    if (t >= INTRO_END) {
+        [self render];
+        return;
+    }
+    link = [cocoaView displayLinkWithTarget:self selector:@selector(tick:)];
+    [link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+}
+
+- (void)fadeAfter:(double)wait
+{
+    CABasicAnimation *a = [CABasicAnimation animationWithKeyPath:@"opacity"];
+    CFTimeInterval now = [self convertTime:CACurrentMediaTime() fromLayer:nil];
+
+    if (fading) {
+        return;
+    }
+    fading = true;
+    info_report("cocoa: start animation fades into the guest's first picture "
+                "(it came %.2f s into the %.1f s animation)", drew_t, INTRO_END);
+    [a setFromValue:@1.0];
+    [a setToValue:@0.0];
+    [a setBeginTime:now + MAX(0, wait)];
+    [a setDuration:INTRO_FADE];
+    [a setFillMode:kCAFillModeBackwards];
+    [a setTimingFunction:[CAMediaTimingFunction
+                          functionWithName:kCAMediaTimingFunctionEaseInEaseOut]];
+    [CATransaction begin];
+    [CATransaction setCompletionBlock:^{
+        [self removeFromSuperlayer];
+        if (omacvm_intro == self) {
+            omacvm_intro = nil;
+            [self release];
+        }
+    }];
+    [self addAnimation:a forKey:@"fade"];
+    [self setOpacity:0];
+    [CATransaction commit];
+}
+
+- (void)tick:(CADisplayLink *)l
+{
+    CFTimeInterval now = [l targetTimestamp];
+
+    if (!start) {
+        start = now;
+    }
+    if (drew_at) {
+        t = rush_from + (now - MAX(drew_at, start)) * rush_rate;
+    } else {
+        t = now - start;
+    }
+    if (t >= INTRO_END) {
+        t = INTRO_END;
+        [link invalidate];
+        link = nil;
+        if (drew_at) {
+            [self fadeAfter:INTRO_WAIT - (CACurrentMediaTime() - drew_at)];
+        }
+    }
+    [self render];
+}
+
+- (void)guestDrew
+{
+    drew_at = CACurrentMediaTime();
+    drew_t = t;
+    if (!link) {
+        [self fadeAfter:INTRO_WAIT];
+        return;
+    }
+    rush_from = t;
+    rush_rate = MAX(1.0, (INTRO_END - t) / INTRO_RUSH);
+}
+@end
+
+/* Main thread: the guest showed its first picture on the main output. */
+static void omacvm_intro_guest_drew(void)
+{
+    [omacvm_intro guestDrew];
+}
+
+/* Main thread, with the BQL (cocoa_display_init): start the animation. */
