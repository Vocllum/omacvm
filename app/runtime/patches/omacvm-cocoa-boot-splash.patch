         glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
         qemu_gl_run_texture_blit(dgc.gls, texture.y_0_top);
+    } else if (omacvm_splash_wanted(NULL, hd->surface)) {
