+
+/*
+ * OmacVM boot splash. Until the guest shows a picture on an output, and when
+ * it switches the output off again (a reboot), the window shows Omarchy's
+ * logo where the firmware draws it, not QEMU's "Display output is not
+ * active." The firmware's frame (the logo 405 x 95 in the middle) is
+ * stretched to the window, so the logo takes the same place here and does
+ * not move at the hand-over. The firmware draws at the size virtio-gpu
+ * reports: 1920 x 1080 (the launcher's xres/yres) on a cold start, after a
+ * reboot the window's own, as the guest did before; so the frame is taken to
+ * be as big as the last picture the guest showed. Outputs the firmware never
+ * draws on (the other displays) get square cells at their own size.
+ *
+ * When the guest has shown nothing of its own OMACVM_SPLASH_HINT_SECONDS
+ * (90) of running time after it started, a line under the logo says so and
+ * where the logs are, and qemu.log gets a warning. OMACVM_BOOT_SPLASH=0:
+ * QEMU's text, as before.
+ *
+ * Threads: the state below is used with the BQL (QEMU's thread, and the
+ * layers' draws on the main thread take it); the hint label is main thread.
+ */
+#define SPLASH_COLS 81
+#define SPLASH_ROWS 19
+
+/*
+ * Omarchy's logo.svg (github.com/basecamp/omarchy 6520ac7d, MIT, (c) David
+ * Heinemeier Hansson), one character per cell, the same cells as the
+ * firmware's logo: boot-logo/make-logo-bmp.py logo.svg --rows. The build
+ * checks that (Tests/display/test-boot-splash-cells.py).
+ */
+static const char omacvm_splash_cells[SPLASH_ROWS][SPLASH_COLS + 1] = {
+    ".................###.............................................................",
+    "..#####......###########......#######....#######....#######....#...#......#...#..",
+    ".#######....#############....########...########...########...##...##....##...##.",
+    "###...###..###...###...###..###...###..###...###..###...###..###...###..###...###",
+    "###...###..###...###...###..###...###..###...###..###...###..###...###..###...###",
+    "###...###..###...###...###..###...###..###...###..###...##...###...###..###...###",
+    "###...###..###...###...###..###...###..###...###..###...#....###...###..###...###",
+    "###...###..###...###...###..###...###..###...###..###........###...###..###...###",
+    "###...###..###...###...###.##########.#########...###.......###########.#########",
+    "###...###..###...###...###.##########.########....###......###########..#########",
+    "###...###..###...###...###..###...###..###........###........###...###........###",
+    "###...###..###...###...###..###...###.##########..###...#....###...###...##...###",
+    "###...###..###...###...###..###...###.##########..###...##...###...###..###...###",
+    "###...###..###...###...###..###...###..###...###..###...###..###...###..###...###",
+    "###...###..###...###...###..###...###..###...###..###...###..###...###..###...###",
+    ".#######....##...###...##...###...##...###...###..########...###...##....#######.",
+    "..#####......#...###...#....###...#....###...###..#######....###...#......#####..",
+    ".......................................###...##..................................",
+    ".......................................###...#...................................",
+};
+
+static int omacvm_splash_on = -1;       /* OMACVM_BOOT_SPLASH */
+static GLuint omacvm_splash_tex;        /* in gl_view_ctx's share group */
+static bool omacvm_guest_drew;          /* a GL scanout since the last reset */
+static int omacvm_frame_w = 1920;       /* the last picture of the guest's */
+static int omacvm_frame_h = 1080;
+static bool omacvm_splash_hint_up;
+static QEMUTimer *omacvm_splash_timer;
+static NSTextField *omacvm_splash_hint; /* main thread */
+
+static bool omacvm_splash_enabled(void)
+{
+    if (omacvm_splash_on < 0) {
+        const char *v = getenv("OMACVM_BOOT_SPLASH");
+        omacvm_splash_on = !(v && !strcmp(v, "0"));
+        info_report("cocoa: boot splash %s",
+                    omacvm_splash_on ? "on" : "off (OMACVM_BOOT_SPLASH=0)");
+    }
+    return omacvm_splash_on;
 }
 
+/* An output without a picture of the guest's: none yet, or switched off. */
+static bool omacvm_splash_wanted(DisplayGLTextureBorrower borrow,
+                                 DisplaySurface *s)
+{
+#ifdef CONFIG_EGL
+    if (egl_surface) {
+        return false;   /* the logo's texture is in the CGL contexts */
+    }
+#endif
+    return !borrow && (!s || surface_is_placeholder(s)) &&
+           omacvm_splash_enabled();
+}
+
+/* With the BQL: the size of the frame the firmware would show on con. */
+static void omacvm_splash_frame(QemuConsole *con, int *fw, int *fh)
+{
+    const QemuUIInfo *info = con ? qemu_console_get_ui_info(con) : NULL;
+
+    *fw = omacvm_frame_w;
+    *fh = omacvm_frame_h;
+    if (con != dcl.con && info && info->width && info->height) {
+        *fw = info->width;
+        *fh = info->height;
+    }
+}
+
+/*
+ * With the BQL, in a CGL context that shares gl_view_ctx's objects: a w x h
+ * pixel output showing con.
+ */
+static void omacvm_splash_draw(QemuConsole *con, int w, int h, bool square)
+{
+    int fw, fh;
+
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (!omacvm_splash_tex) {
+        static uint32_t px[SPLASH_ROWS * SPLASH_COLS];
+        for (int r = 0; r < SPLASH_ROWS; r++) {
+            for (int c = 0; c < SPLASH_COLS; c++) {
+                /* Omarchy green (#a8cd76) on black, as the firmware. */
+                px[r * SPLASH_COLS + c] = omacvm_splash_cells[r][c] == '#' ?
+                                          0xffa8cd76 : 0xff000000;
+            }
+        }
+        glGenTextures(1, &omacvm_splash_tex);
+        glBindTexture(GL_TEXTURE_2D, omacvm_splash_tex);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, SPLASH_COLS, SPLASH_ROWS, 0,
+                     GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, px);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+    /* One cell: 5 x 5 pixels of the firmware's frame. */
+    omacvm_splash_frame(con, &fw, &fh);
+    double cw = w * 5.0 / fw, ch = h * 5.0 / fh;
+    if (square) {
+        cw = ch = MIN(cw, ch);
+    }
+    int lw = MAX(1, (int)lround(SPLASH_COLS * cw));
+    int lh = MAX(1, (int)lround(SPLASH_ROWS * ch));
+
+    glViewport((w - lw) / 2, (h - lh) / 2, lw, lh);
+    glBindTexture(GL_TEXTURE_2D, omacvm_splash_tex);
+    /* Sharp cells, whatever the zoom filter. */
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    qemu_gl_run_texture_blit(dgc.gls, false);
+    glViewport(0, 0, w, h);
+}
+
+/* Main thread: the hint under the logo of the main window (fh: frame height). */
+static void omacvm_splash_hint_show(bool show, int fh)
+{
+    if (!show) {
+        [omacvm_splash_hint removeFromSuperview];
+        return;
+    }
+    if (!omacvm_splash_hint) {
+        const char *logs = getenv("OMACVM_LOGS");
+        NSString *text = logs && *logs ?
+            [NSString stringWithFormat:@"Omarchy is taking long to start. Its logs: %@",
+             [[NSString stringWithUTF8String:logs] stringByAbbreviatingWithTildeInPath]] :
+            @"Omarchy is taking long to start. Its logs are in the VM's folder.";
+        omacvm_splash_hint = [[NSTextField labelWithString:text] retain];
+        [omacvm_splash_hint setFont:[NSFont monospacedSystemFontOfSize:13
+                                                                weight:NSFontWeightRegular]];
+        [omacvm_splash_hint setTextColor:[NSColor colorWithSRGBRed:0.66 green:0.69
+                                                              blue:0.84 alpha:1]];
+        [omacvm_splash_hint sizeToFit];
+        [omacvm_splash_hint setAutoresizingMask:NSViewMinXMargin | NSViewMaxXMargin |
+                                                NSViewMinYMargin | NSViewMaxYMargin];
+    }
+    NSRect b = [cocoaView bounds];
+    NSSize size = [omacvm_splash_hint frame].size;
+    /* Under the logo (95 of the frame's rows, in the middle). */
+    CGFloat y = b.size.height / 2 - b.size.height * 95 / MAX(fh, 95) / 2 - 32 - size.height;
+    [omacvm_splash_hint setFrame:NSMakeRect(floor((b.size.width - size.width) / 2),
+                                            floor(MAX(8, y)), size.width, size.height)];
+    if (![omacvm_splash_hint superview]) {
+        [cocoaView addSubview:omacvm_splash_hint];
+    }
+}
+
+static int omacvm_splash_hint_seconds(void)
+{
+    static int seconds;
+    if (!seconds) {
+        const char *v = getenv("OMACVM_SPLASH_HINT_SECONDS");
+        seconds = v && atoi(v) > 0 ? MIN(atoi(v), 3600) : 90;
+    }
+    return seconds;
+}
+
+/* QEMU's thread, BQL: the guest has run that long and shows nothing yet. */
+static void omacvm_splash_hint_timer(void *opaque)
+{
+    if (omacvm_guest_drew || !omacvm_splash_wanted(gl_scanout_borrow, surface)) {
+        return;
+    }
+    int fw, fh;
+
+    omacvm_splash_frame(dcl.con, &fw, &fh);
+    omacvm_splash_hint_up = true;
+    warn_report("cocoa: no picture from the guest %d s after it started",
+                omacvm_splash_hint_seconds());
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_splash_hint_show(true, fh);
+    });
+}
+
+/* QEMU's thread, BQL: the main output changed. */
+static void omacvm_splash_update(void)
+{
+    if (gl_scanout_borrow) {
+        omacvm_guest_drew = true;
+    }
+    if (surface && !surface_is_placeholder(surface)) {
+        omacvm_frame_w = surface_width(surface);
+        omacvm_frame_h = surface_height(surface);
+    }
+    if (!omacvm_guest_drew && omacvm_splash_wanted(gl_scanout_borrow, surface)) {
+        /* Guest time: a paused VM is not slow to start. */
+        if (!omacvm_splash_timer) {
+            omacvm_splash_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                               omacvm_splash_hint_timer, NULL);
+        }
+        if (!omacvm_splash_hint_up && !timer_pending(omacvm_splash_timer)) {
+            timer_mod(omacvm_splash_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                                           omacvm_splash_hint_seconds() * 1000LL);
+        }
+        return;
+    }
+    if (omacvm_splash_timer) {
+        timer_del(omacvm_splash_timer);
+    }
+    if (omacvm_splash_hint_up) {
+        omacvm_splash_hint_up = false;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            omacvm_splash_hint_show(false, 0);
+        });
+    }
+}
+
+/* A guest reset starts over: the hint counts again from the next splash. */
+static void omacvm_splash_reset(void *opaque)
+{
+    omacvm_guest_drew = false;
+}
