From: OmacVM
Subject: [PATCH] virtio-gpu: blob alignment for 16 KiB host pages

HVF maps guest memory in 16 KiB pages on Apple Silicon (macOS 15 has no
4 KiB granule), but a 4 KiB Linux guest places host-visible blobs on 4 KiB
boundaries: such a blob cannot be mapped and Venus (Vulkan) memory breaks.
Offer VIRTIO_GPU_F_BLOB_ALIGNMENT with the host page size: Linux 6.x+ then
sizes every blob to it (Mesa's Venus driver asks for the value), so every
blob lands on a host page. A blob's host mapping is rounded up to whole
pages to match.

diff --git a/hw/display/virtio-gpu-base.c b/hw/display/virtio-gpu-base.c
index 270fbaa..ee53ffe 100644
--- a/hw/display/virtio-gpu-base.c
+++ b/hw/display/virtio-gpu-base.c
@@ -276,6 +276,17 @@ virtio_gpu_base_get_features(VirtIODevice *vdev, uint64_t features,
     if (virtio_gpu_resource_uuid_enabled(g->conf)) {
         features |= (1 << VIRTIO_GPU_F_RESOURCE_UUID);
     }
+    /*
+     * Blobs are mapped into the guest with the host's page size (16 KiB
+     * under HVF on Apple Silicon): a 4 KiB guest must size and place them
+     * on that boundary, or they cannot be mapped at all.
+     */
+    if (virtio_gpu_blob_enabled(g->conf) &&
+        qemu_real_host_page_size() > 4096) {
+        features |= (1ULL << VIRTIO_GPU_F_BLOB_ALIGNMENT);
+        g->virtio_config.blob_alignment =
+            cpu_to_le32(qemu_real_host_page_size());
+    }
 
     return features;
 }
diff --git a/hw/display/virtio-gpu-virgl.c b/hw/display/virtio-gpu-virgl.c
index a51ed16..d4ed3e6 100644
--- a/hw/display/virtio-gpu-virgl.c
+++ b/hw/display/virtio-gpu-virgl.c
@@ -222,6 +223,16 @@ virtio_gpu_virgl_map_resource_blob(VirtIOGPU *g,
     vmr->mapping_state = VIRTIO_GPU_MR_MAPPED;
 
     mr = &vmr->mr;
+    /*
+     * The guest sizes blobs to the host page (blob_alignment). A mapping
+     * starts on a host page, so the rest of its last page is the same
+     * memory: map whole pages, or the accelerator cannot map it at all.
+     */
+    if (size < res->base.blob_size &&
+        QEMU_IS_ALIGNED((uintptr_t)data, qemu_real_host_page_size()) &&
+        ROUND_UP(size, qemu_real_host_page_size()) >= res->base.blob_size) {
+        size = res->base.blob_size;
+    }
     memory_region_init_ram_ptr(mr, OBJECT(vmr), "mr", size, data);
     memory_region_add_subregion_overlap(&b->hostmem, offset, mr, 1);
 
