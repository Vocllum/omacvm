+/* GLES shaders carry their own #version. On desktop GL, core profiles need
+ * not accept GLSL 1.30 (macOS refuses it), so use the newest version the blit
+ * shaders need: 4.00 makes cube map arrays core, 1.50 multisample textures. */
+static void blit_set_glsl_version(struct vrend_blitter_ctx *blit_ctx, int gl_ver)
+{
+   if (blit_ctx->use_gles)
+      return;
+   blit_ctx->glsl_ver = gl_ver >= 40 ? 400 : gl_ver >= 32 ? 150 : 130;
+   snprintf(blit_ctx->glsl_header, sizeof(blit_ctx->glsl_header),
+            "#version %d\n", blit_ctx->glsl_ver);
+}
