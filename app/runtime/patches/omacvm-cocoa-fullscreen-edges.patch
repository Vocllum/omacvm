+/*
+ * While the VM has the pointer in full screen, the Mac's cursor never reaches
+ * a corner of its display (a macOS hot corner: one put the Mac's display to
+ * sleep from inside the VM) nor the Dock's edge (on another display than the
+ * main window's the Dock came up there). Moving the cursor back after it got
+ * there is too late, so within 200 points of a corner or the Dock's edge the
+ * cursor is detached from the mouse and stays where it is, and the guest's
+ * pointer moves on by the mouse's motion: the same motion macOS moves the
+ * cursor by, so it feels the same there. The maths is in
+ * ui/omacvm-pointer-guard.h. Edges shared with another display stay open.
+ * Off with immersive=off; leaving the zone, our windows, full screen, the
+ * Space or the VM gives the cursor back where the pointer is.
+ */
+/* The guard's place as a point in one of our views; false when this event has its own. */
+static bool omacvm_guarded_target(NSView **view, int *output, NSPoint *p)
+{
+    NSPoint q;
+
+    if (!omacvm_guard_place) {
+        return false;
+    }
+    q = NSMakePoint(omacvm_guard.x,
+                    NSMaxY([[[NSScreen screens] firstObject] frame]) - omacvm_guard.y);
+    for (int i = 0; i < omacvm_outputs; i++) {
+        NSWindow *w = i ? omacvm_heads[i].window : [cocoaView window];
+        NSView *v = i ? omacvm_heads[i].view : cocoaView;
+        if (w && v && [w isVisible] && NSPointInRect(q, [w frame])) {
+            *view = v;
+            *output = i;
+            *p = [v convertPoint:[w convertPointFromScreen:q] fromView:nil];
+            return true;
+        }
+    }
+    return false;
+}
+
+static void omacvm_guard_apply(const OmacVMGuardStep *st)
+{
+    if (st->warp) {
+        CGWarpMouseCursorPosition(CGPointMake(st->wx, st->wy));
+    }
+    if (st->detach) {
+        /* Without this the cursor stalls for a moment after a warp. */
+        CGEventSourceRef src = CGEventSourceCreate(kCGEventSourceStateCombinedSessionState);
+        if (src) {
+            CGEventSourceSetLocalEventsSuppressionInterval(src, 0);
+            CFRelease(src);
+        }
+        CGAssociateMouseAndMouseCursorPosition(false);
+    }
+    if (st->attach) {
+        CGAssociateMouseAndMouseCursorPosition(true);
+    }
+}
+
+/* The Mac's displays and our visible windows, for the guard (CoreGraphics' space). */
+static void omacvm_guard_screens(OmacVMGuardScreens *s, OmacVMRect *displays,
+                                 int max_displays, OmacVMRect *ours, int max_ours)
+{
+    CGDirectDisplayID ids[16];
+    uint32_t n = 0;
+    CGFloat top = NSMaxY([[[NSScreen screens] firstObject] frame]);
+
+    memset(s, 0, sizeof(*s));
+    if (CGGetActiveDisplayList(16, ids, &n) != kCGErrorSuccess) {
+        n = 0;
+    }
+    for (uint32_t i = 0; i < n && s->ndisplays < max_displays; i++) {
+        CGRect r = CGDisplayBounds(ids[i]);
+        displays[s->ndisplays++] = (OmacVMRect){ r.origin.x, r.origin.y,
+                                                 r.size.width, r.size.height };
+    }
+    for (int i = 0; i < omacvm_outputs && s->nours < max_ours; i++) {
+        NSWindow *w = i ? omacvm_heads[i].window : [cocoaView window];
+        NSRect f;
+
+        if (!w || ![w isVisible] ||
+            !([w occlusionState] & NSWindowOcclusionStateVisible)) {
+            continue;
+        }
+        f = [w frame];
+        ours[s->nours++] = (OmacVMRect){ f.origin.x, top - NSMaxY(f),
+                                         f.size.width, f.size.height };
+    }
+    s->displays = displays;
+    s->ours = ours;
+    s->dock_edge = omacvm_dock_edge();
+}
+
+static void omacvm_corner_release(void)
+{
+    OmacVMGuardStep st;
+    OmacVMGuardScreens s;
+    OmacVMRect displays[16], ours[OMACVM_MAX_OUTPUTS];
+
+    omacvm_guard_place = false;
+    if (!omacvm_guard.held) {
+        return;
+    }
+    omacvm_guard_screens(&s, displays, 16, ours, OMACVM_MAX_OUTPUTS);
+    memset(&st, 0, sizeof(st));
+    omacvm_guard_release(&omacvm_guard, &s, &st);
+    omacvm_guard_apply(&st);
+}
+
+/* The edge the Dock sits on (read again on each full screen). */
+static int omacvm_dock_edge(void)
+{
+    if (omacvm_dock_edge_cache < 0) {
+        CFPropertyListRef v = CFPreferencesCopyAppValue(CFSTR("orientation"),
+                                                        CFSTR("com.apple.dock"));
+        omacvm_dock_edge_cache = OMACVM_DOCK_BOTTOM;
+        if (v && CFGetTypeID(v) == CFStringGetTypeID()) {
+            if (CFStringCompare((CFStringRef)v, CFSTR("left"), 0) == kCFCompareEqualTo) {
+                omacvm_dock_edge_cache = OMACVM_DOCK_LEFT;
+            } else if (CFStringCompare((CFStringRef)v, CFSTR("right"), 0) == kCFCompareEqualTo) {
+                omacvm_dock_edge_cache = OMACVM_DOCK_RIGHT;
+            }
+        }
+        if (v) {
+            CFRelease(v);
+        }
+    }
+    return omacvm_dock_edge_cache;
+}
+
+static void omacvm_guard_corners(NSEvent *event)
+{
+    OmacVMGuardStep st;
+    OmacVMGuardScreens s;
+    OmacVMRect displays[16], ours[OMACVM_MAX_OUTPUTS];
+    CGEventRef cg = [event CGEvent], now;
+    CGPoint loc, cur;
+    double dx = 0, dy = 0;
+
+    omacvm_guard_place = false;
+    if (!immersive_mode_enabled || !omacvm_main_full_screen()) {
+        omacvm_corner_release();
+        return;
+    }
+    switch ([event type]) {
+    case NSEventTypeMouseMoved:
+    case NSEventTypeLeftMouseDragged:
+    case NSEventTypeRightMouseDragged:
+    case NSEventTypeOtherMouseDragged:
+        /* macOS's motion after its acceleration, in points (the cursor's own). */
+        dx = [event deltaX];
+        dy = [event deltaY];
+        break;
+    case NSEventTypeLeftMouseDown:
+    case NSEventTypeLeftMouseUp:
+    case NSEventTypeRightMouseDown:
+    case NSEventTypeRightMouseUp:
+    case NSEventTypeOtherMouseDown:
+    case NSEventTypeOtherMouseUp:
+        break;
+    default:
+        /* Entered and the like: AppKit's, made from a motion the guard saw. */
+        omacvm_guard_place = omacvm_guard.held;
+        return;
+    }
+    now = CGEventCreate(NULL);
+    if (!cg || !now) {
+        if (now) {
+            CFRelease(now);
+        }
+        omacvm_guard_place = omacvm_guard.held;
+        return;
+    }
+    cur = CGEventGetLocation(now);
+    CFRelease(now);
+    loc = CGEventGetLocation(cg);
+    omacvm_guard_screens(&s, displays, 16, ours, OMACVM_MAX_OUTPUTS);
+    omacvm_guard_event(&omacvm_guard, &s, [event timestamp], loc.x, loc.y,
+                       dx, dy, cur.x, cur.y, &st);
+    omacvm_guard_apply(&st);
+    omacvm_guard_place = st.place;
+}
+
 /* A display's rectangle in points, top-left origin (CoreGraphics' global space). */
 static OmacVMBox omacvm_display_box(NSScreen *s, bool below_notch)
 {
@@ -3692,6 +3906,22 @@ - (BOOL)windowShouldClose:(id)sender
     return NO;
 }
 
+/*
+ * The other displays' full-screen Spaces hide the Dock and the menu bar like
+ * the main window's (macOS's default there auto-hides them: the Dock came up
+ * at the bottom edge of an external display).
+ */
+- (NSApplicationPresentationOptions)window:(NSWindow *)window
+      willUseFullScreenPresentationOptions:(NSApplicationPresentationOptions)proposedOptions
+{
+    if (!immersive_mode_enabled) {
+        return proposedOptions;
+    }
+    return (proposedOptions & ~(NSApplicationPresentationAutoHideDock |
+                                NSApplicationPresentationAutoHideMenuBar)) |
+           NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar;
+}
