#!/usr/bin/env python3
"""omacvm-gestures (guest side): replays the Mac trackpad's multi-finger
gestures on a virtual touchpad, so libinput/Hyprland see 3/4-finger swipes and
pinch/rotate like on a real Apple touchpad.

Connects to the Mac helper (gestures/mac) on the Mac's address on the VM network (from /etc/omacvm/env)
and reads lines:
  F <n> [<id> <x> <y> <size>]...   finger frame, x/y 0..1 (y down)
  S <on|off|esc>                    capture state (esc = released by the escape combo)
  W <dx> <dy>                       scrolling as macOS shaped it (points), for the
                                    virtual high-resolution wheel

The helper only sends 3+-finger frames and 2-finger pinches; one-finger
movement, clicks and two-finger scrolling keep coming from Parallels' own
virtual mouse. Runs as root (uinput); posts a notification to the desktop user
when the escape combo is used.
"""
import glob
import math
import os
import pwd
import socket
import subprocess
import sys
import time

from evdev import AbsInfo, UInput, ecodes as e

HOST = os.environ.get("OMACVM_GESTURES_HOST") or os.environ.get("OMACVM_HOST") or "10.211.55.2"
PORT = int(os.environ.get("OMACVM_GESTURES_PORT", "47830"))
USER = os.environ.get("OMACVM_GESTURES_USER", "")   # default: whoever owns the Wayland session
# Built-in MacBook Pro 16" trackpad: 156 x 96 mm; 100 units per mm. The real
# trackpad maps onto the middle of a much larger virtual one, so a glide from
# macOS's momentum (--scroll) has room to run; fingers feel exactly the same.
W, H, RES = 15600, 9600, 100
PAD_W, PAD_H = 100000, 100000
OFF_X, OFF_Y = (PAD_W - W) // 2, (PAD_H - H) // 2
SLOTS = 10
TOOLS = [e.BTN_TOOL_FINGER, e.BTN_TOOL_DOUBLETAP, e.BTN_TOOL_TRIPLETAP, e.BTN_TOOL_QUADTAP, e.BTN_TOOL_QUINTTAP]


def make_device():
    caps = {
        e.EV_KEY: [e.BTN_LEFT, e.BTN_TOUCH] + TOOLS,
        e.EV_ABS: [
            (e.ABS_X, AbsInfo(0, 0, PAD_W, 0, 0, RES)),
            (e.ABS_Y, AbsInfo(0, 0, PAD_H, 0, 0, RES)),
            (e.ABS_MT_SLOT, AbsInfo(0, 0, SLOTS - 1, 0, 0, 0)),
            (e.ABS_MT_TRACKING_ID, AbsInfo(0, 0, 65535, 0, 0, 0)),
            (e.ABS_MT_POSITION_X, AbsInfo(0, 0, PAD_W, 0, 0, RES)),
            (e.ABS_MT_POSITION_Y, AbsInfo(0, 0, PAD_H, 0, 0, RES)),
        ],
    }
    # Apple vendor id, Magic Trackpad (USB-C) product id: libinput applies its
    # Apple touchpad handling. INPUT_PROP_BUTTONPAD = clickpad.
    return UInput(caps, name="Apple Inc. Magic Trackpad (OmacVM)", vendor=0x05AC, product=0x0324,
                  version=0x0111, bustype=e.BUS_USB, input_props=[e.INPUT_PROP_POINTER, e.INPUT_PROP_BUTTONPAD])


class Touchpad:
    def __init__(self, ui):
        self.ui = ui
        self.slots = {}          # mac contact id -> slot
        self.next_tid = 1
        self.tool = None
        self.last_write = 0.0
        self.pending = None

    MIN_GAP = 0.003      # seconds between frames: libinput normalizes movement to time,
                         # so frames microseconds apart look like leaps ("touch jump")

    def frame(self, contacts):
        """Write a frame; the same fingers' frames arriving closer than MIN_GAP are
        coalesced (positions are absolute), a lift and a new touch never share
        one frame (libinput rejects that)."""
        ids = {c[0] for c in contacts}
        if contacts and ids == set(self.slots) and time.monotonic() - self.last_write < self.MIN_GAP:
            self.pending = contacts
            return
        self.pending = None
        if contacts and set(self.slots) - ids and ids - set(self.slots):
            self._write([c for c in contacts if c[0] in self.slots])   # lifts first
        self._write(contacts)

    def flush(self):
        if self.pending is not None and time.monotonic() - self.last_write >= self.MIN_GAP:
            contacts, self.pending = self.pending, None
            self._write(contacts)

    def _write(self, contacts):
        ui = self.ui
        ids = {c[0] for c in contacts}
        for cid in [c for c in self.slots if c not in ids]:          # lifted fingers
            ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots.pop(cid))
            ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
        free = [s for s in range(SLOTS) if s not in self.slots.values()]
        for cid, x, y in contacts:
            if cid not in self.slots:
                if not free:
                    continue
                self.slots[cid] = free.pop(0)
                ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots[cid])
                ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, self.next_tid)
                self.next_tid = self.next_tid % 65535 + 1
            ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots[cid])
            ui.write(e.EV_ABS, e.ABS_MT_POSITION_X, x)
            ui.write(e.EV_ABS, e.ABS_MT_POSITION_Y, y)
        n = len(self.slots)
        tool = TOOLS[min(n, 5) - 1] if n else None
        if tool != self.tool:
            if self.tool is not None:
                ui.write(e.EV_KEY, self.tool, 0)
            if tool is not None:
                ui.write(e.EV_KEY, tool, 1)
            if (self.tool is None) != (tool is None):
                ui.write(e.EV_KEY, e.BTN_TOUCH, 1 if tool else 0)
            self.tool = tool
        if contacts:
            ui.write(e.EV_ABS, e.ABS_X, contacts[0][1])
            ui.write(e.EV_ABS, e.ABS_Y, contacts[0][2])
        ui.syn()
        self.last_write = time.monotonic()

    def release(self):
        if self.slots or self.tool:
            self.frame([])


# One wheel detent (120 high-resolution units) per this many macOS points.
POINTS_PER_DETENT = float(os.environ.get("OMACVM_SCROLL_POINTS_PER_DETENT", "40"))
# How macOS's scrolling reaches the apps: "wheel" (a high-resolution wheel) or
# "touch" (two virtual fingers on the touchpad, moved by macOS's deltas, lifted
# once macOS's momentum has died down, so apps add no fling of their own).
SCROLL_MODE = os.environ.get("OMACVM_SCROLL_MODE", "wheel")
TOUCH_UNITS_PER_POINT = float(os.environ.get("OMACVM_SCROLL_TOUCH_SCALE", "4"))
SCROLL_DEBUG = bool(os.environ.get("OMACVM_SCROLL_DEBUG"))
# macOS sends slow scrolling as 1-point steps; after the compositor's touchpad
# factor they reach apps as fractions of a pixel, which Chrome partly drops.
# Steps below SLOW_UNTIL points get extra movement: SLOW_BOOST points at a
# 1-point step, tapering to none at SLOW_UNTIL (1 -> 2, 2 -> 2.5, 3 -> 3 with the
# defaults); normal and fast scrolling stay exactly as macOS sends it.
SLOW_BOOST = float(os.environ.get("OMACVM_SCROLL_SLOW_BOOST", "1.0"))
SLOW_UNTIL = 3.0


def slow_boost(d):
    a = abs(d)
    if not 0 < a < SLOW_UNTIL:
        return d
    extra = SLOW_BOOST * min(1.0, (SLOW_UNTIL - a) / (SLOW_UNTIL - 1))
    return d + extra if d > 0 else d - extra
# Seconds without scrolling before the fingers lift. libinput only starts a
# two-finger scroll after the fingers have moved a little; staying down through
# the pauses of slow, fine scrolling avoids paying that again and again.
TOUCH_LIFT_AFTER = float(os.environ.get("OMACVM_SCROLL_TOUCH_HOLD", "0.5"))


def make_wheel():
    """A virtual high-resolution wheel for macOS's scrolling (--scroll on the Mac):
    apps get the finished movement, macOS's acceleration and momentum included."""
    caps = {
        e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE],
        e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_HWHEEL, e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES],
    }
    return UInput(caps, name="OmacVM scroll (macOS)", vendor=0x05AC, product=0x0001, bustype=e.BUS_VIRTUAL)


class Wheel:
    def __init__(self, ui):
        self.ui = ui
        self.hi = [0.0, 0.0]     # high-resolution remainders (x, y)
        self.lo = [0, 0]         # high-resolution units toward the next legacy detent

    def scroll(self, dx, dy):
        # macOS: positive dy = content moves down (natural scrolling already
        # applied) = REL_WHEEL positive; positive dx = content moves right =
        # REL_HWHEEL negative.
        for i, (v, hi, lo) in enumerate(((-dx, e.REL_HWHEEL_HI_RES, e.REL_HWHEEL), (dy, e.REL_WHEEL_HI_RES, e.REL_WHEEL))):
            self.hi[i] += v * 120.0 / POINTS_PER_DETENT
            n = int(self.hi[i])
            if not n:
                continue
            self.hi[i] -= n
            self.ui.write(e.EV_REL, hi, n)
            self.lo[i] += n
            d = int(self.lo[i] / 120)
            if d:
                self.lo[i] -= d * 120
                self.ui.write(e.EV_REL, lo, d)
        self.ui.syn()


class TouchScroll:
    """macOS's scroll deltas as two fingers moving on the virtual touchpad."""
    IDS = (100001, 100002)

    def __init__(self, pad):
        self.pad = pad
        self.down = False
        self.last = 0.0
        self.x = self.y = 0.0

    def _place(self):
        self.x, self.y = PAD_W / 2, PAD_H / 2
        self.down = True

    def _frame(self):
        x, y, gap = round(self.x), round(self.y), 1500
        self.pad.frame([(self.IDS[0], x - gap // 2, y), (self.IDS[1], x + gap // 2, y)])

    def scroll(self, dx, dy):
        # Natural scrolling (macOS's deltas already have it): content moves
        # with the fingers.
        if not self.down:
            self._place()
            self._frame()
        dx, dy = slow_boost(dx), slow_boost(dy)
        nx = self.x + dx * TOUCH_UNITS_PER_POINT
        ny = self.y + dy * TOUCH_UNITS_PER_POINT
        if not (1500 < nx < PAD_W - 1500 and 1000 < ny < PAD_H - 1000):
            # Off the edge: hold still for a moment, lift, start again in the middle.
            for _ in range(3):
                self._frame()
                time.sleep(0.008)
            self.pad.frame([])
            self._place()
            self._frame()
            nx, ny = self.x + dx * TOUCH_UNITS_PER_POINT, self.y + dy * TOUCH_UNITS_PER_POINT
        self.x, self.y = nx, ny
        self._frame()
        self.last = time.monotonic()

    def idle(self):
        if self.down and time.monotonic() - self.last > TOUCH_LIFT_AFTER:
            self.pad.frame([])
            self.down = False


class OneEuro:
    """One Euro filter (Casiez et al.): smooths strongly when slow or still (finger
    jitter), hardly at all when fast (no lag). Values in millimetres."""

    def __init__(self, min_cutoff, beta, d_cutoff=1.0):
        self.min_cutoff, self.beta, self.d_cutoff = min_cutoff, beta, d_cutoff
        self.x = self.dx = self.t = None

    @staticmethod
    def _alpha(cutoff, dt):
        tau = 1.0 / (2 * math.pi * cutoff)
        return 1.0 / (1.0 + tau / dt)

    def __call__(self, x, t):
        if self.x is None:
            self.x, self.dx, self.t = x, 0.0, t
            return x
        dt = max(t - self.t, 1e-4)
        dx = (x - self.x) / dt
        a_d = self._alpha(self.d_cutoff, dt)
        self.dx = a_d * dx + (1 - a_d) * self.dx
        a = self._alpha(self.min_cutoff + self.beta * abs(self.dx), dt)
        self.x = a * x + (1 - a) * self.x
        self.t = t
        return self.x


# "min_cutoff beta d_cutoff": smoothing at rest (Hz), how fast it opens with
# speed, and how quickly a change of speed is noticed (Hz).
_f = (os.environ.get("OMACVM_SCROLL_FILTER", "") or "1.5 0.4 8").split()
FILTER_MIN_CUTOFF, FILTER_BETA = float(_f[0]), float(_f[1])
FILTER_D_CUTOFF = float(_f[2]) if len(_f) > 2 else 8.0
# Acceleration of two-finger scrolling, like macOS's: gain 1 below V0 mm/s of
# finger speed (fine scrolling stays exact), rising smoothly to GAIN at V1.
_a = os.environ.get("OMACVM_SCROLL_ACCEL", "15 150 3").split()
ACCEL_V0, ACCEL_V1, ACCEL_GAIN = float(_a[0]), float(_a[1]), float(_a[2])


def scroll_gain(v):
    if v <= ACCEL_V0:
        return 1.0
    x = min(1.0, (v - ACCEL_V0) / (ACCEL_V1 - ACCEL_V0))
    return 1.0 + (ACCEL_GAIN - 1.0) * x * x * (3 - 2 * x)    # smoothstep


# macOS's own acceleration (from its scroll while the fingers touch, "A" lines):
# over ACCEL_WINDOW seconds, macOS points per millimetre of finger movement,
# relative to that ratio during slow scrolling (calibrated as you scroll),
# scales the raw movement; capped at ACCEL_MAX.
ACCEL_WINDOW = 0.15
ACCEL_MAX = float(os.environ.get("OMACVM_SCROLL_ACCEL_MAX", "6"))
ACCEL_SLOW = 20.0            # mm/s: below this a window calibrates the base ratio


# How much further the glide after a flick carries than macOS's momentum at
# the fingers' speed (1 = exactly macOS's distance).
GLIDE = float(os.environ.get("OMACVM_SCROLL_GLIDE", "1.5"))


# Pinch is macOS's decision ("P" from the Mac, when macOS recognizes a magnify
# gesture). OMACVM_SCROLL_PINCH_MM > 0 adds a spread-based fallback.
PINCH_MM = float(os.environ.get("OMACVM_SCROLL_PINCH_MM", "0"))


class Hybrid:
    """--scroll on the Mac with touch mode: the real two-finger frames while the
    fingers touch (precise to hundredths of a millimetre), then macOS's momentum
    on the same virtual fingers, which stay down until it has died down."""
    MOMENTUM_WAIT = 0.15     # seconds to wait for macOS's momentum after a lift

    def __init__(self, pad, touch):
        self.pad, self.touch = pad, touch
        self.contacts = []   # the last real contacts
        self.hist = []       # (time, x, y) of the two-finger centroid, last frames
        self.held = None     # contacts kept down after the real fingers lifted
        self.lifted = 0.0
        self.moved = 0.0     # last momentum step
        self.scale = None    # touchpad units per macOS point for this momentum
        self.wprev = None
        self.pending = [0.0, 0.0]   # momentum not yet applied, touchpad units
        self.tick = 0.0
        self.two = None      # current two-finger touch: ids, offsets, start, mode, filters
        self.apts = []       # (time, macOS points) while the fingers touch
        self.amm = []        # (time, finger millimetres)
        self.base = float(os.environ["OMACVM_SCROLL_BASE"]) if os.environ.get("OMACVM_SCROLL_BASE") else None
        self.logged = 0.0

    def frame(self, contacts):
        now = time.monotonic()
        if contacts:
            if self.held is not None:
                # Fingers back during a glide: end the glide's touch first, so
                # the new touch does not continue it (the trackpad reuses ids)
                # and leap back from where the glide had got to.
                self.held = None
                self.pending = [0.0, 0.0]
                self.pad.frame([])
            self.touch.down = False
            if len(contacts) == 2:
                contacts = self.two_fingers(contacts, now)
            elif self.two is not None:
                # Leaving a two-finger scroll (a third finger, a swipe): its
                # virtual positions differ from the raw ones, so end that touch
                # instead of letting the fingers leap (libinput drops leaps as jumps).
                if not self.two["pinch"]:
                    self.pad.frame([])
                self.two = None
            if len(contacts) == 2:
                self.hist = (self.hist + [(now, (contacts[0][1] + contacts[1][1]) / 2,
                                           (contacts[0][2] + contacts[1][2]) / 2)])[-5:]
            else:
                self.hist = []
            self.contacts = contacts
            self.pad.frame(contacts)
            return
        if len(self.contacts) == 2 and len(self.hist) >= 2:
            # Two fingers lifted: stay down, macOS's momentum may follow.
            self.held = [list(c) for c in self.contacts]
            self.lifted, self.scale, self.wprev = now, None, None
            self.pending = [0.0, 0.0]
            self.contacts = []
            return
        self.contacts, self.hist = [], []
        self.pad.frame([])

    def two_fingers(self, contacts, now):
        """Scroll stays scroll: the fingers' spacing is fixed at touch-down and the
        filtered centre moves; a clear spread switches to raw fingers (pinch)."""
        ids = (contacts[0][0], contacts[1][0])
        cx = (contacts[0][1] + contacts[1][1]) / 2
        cy = (contacts[0][2] + contacts[1][2]) / 2
        dist = math.hypot(contacts[0][1] - contacts[1][1], contacts[0][2] - contacts[1][2])
        t = self.two
        if t is None or t["ids"] != ids:
            t = self.two = {"ids": ids, "c0": (cx, cy), "d0": dist, "pinch": False,
                            "off": [(c[1] - cx, c[2] - cy) for c in contacts],
                            "fx": OneEuro(FILTER_MIN_CUTOFF, FILTER_BETA, FILTER_D_CUTOFF),
                            "fy": OneEuro(FILTER_MIN_CUTOFF, FILTER_BETA, FILTER_D_CUTOFF)}
        if not t["pinch"] and PINCH_MM > 0:
            spread = abs(dist - t["d0"]) / RES
            moved = math.hypot(cx - t["c0"][0], cy - t["c0"][1]) / RES
            if spread > PINCH_MM and spread > moved:
                t["pinch"] = True
        if t["pinch"]:
            if t.pop("restart", False):
                if SCROLL_DEBUG:
                    print(f"restart {time.monotonic():.3f}", flush=True)
                self.pad.frame([])   # lift; the raw fingers below begin a new touch
            return contacts
        fx = t["fx"](cx / RES, now) * RES
        fy = t["fy"](cy / RES, now) * RES
        if "vx" not in t:
            t.update(vx=fx, vy=fy, px=fx, py=fy, pt=now, speed=0.0)
        else:
            # The virtual centre moves by the filtered movement times the gain
            # for the current finger speed (mm/s, smoothed).
            dx, dy, dt = fx - t["px"], fy - t["py"], max(now - t["pt"], 1e-3)
            target = self.macos_gain(now, math.hypot(dx, dy) / RES)
            t["gain"] = t.get("gain", 1.0) + (target - t.get("gain", 1.0)) * 0.25
            t["vx"] += dx * t["gain"]
            t["vy"] += dy * t["gain"]
            t.update(px=fx, py=fy, pt=now)
        vx = min(max(t["vx"], 2000), PAD_W - 2000)
        vy = min(max(t["vy"], 2000), PAD_H - 2000)
        return [(c[0], round(vx + o[0]), round(vy + o[1])) for c, o in zip(contacts, t["off"])]

    def macos(self, dx, dy):
        """macOS's scroll for the current touch (points): only its amount is used."""
        self.apts.append((time.monotonic(), math.hypot(dx, dy)))

    def macos_gain(self, now, mm):
        self.amm.append((now, mm))
        cut = now - ACCEL_WINDOW
        self.apts = [a for a in self.apts if a[0] >= cut]
        self.amm = [a for a in self.amm if a[0] >= cut]
        sp = sum(a[1] for a in self.apts)
        sm = sum(a[1] for a in self.amm)
        if sm < 0.3 or sp <= 0:
            return 1.0
        r = sp / sm
        if sm / ACCEL_WINDOW < ACCEL_SLOW:
            self.base = r if self.base is None else 0.9 * self.base + 0.1 * r
        target = min(max(r / (self.base or r), 1.0), ACCEL_MAX)
        if SCROLL_DEBUG and now - self.logged > 0.3:
            print(f"accel: {sm / ACCEL_WINDOW:.0f} mm/s, {r:.1f} pt/mm, base {self.base or 0:.1f}, gain {target:.2f}", flush=True)
            self.logged = now
        return target

    def pinch(self):
        """macOS recognized a pinch: the current two-finger touch goes raw. libinput
        never turns a running scroll into a pinch, so the touch starts afresh."""
        if SCROLL_DEBUG:
            print(f"P {time.monotonic():.3f} two={'yes' if self.two else 'no'} "
                  f"pinch={self.two and self.two['pinch']}", flush=True)
        if self.two is not None and not self.two["pinch"]:
            self.two["pinch"] = True
            self.two["restart"] = True

    def momentum(self, dx, dy):
        if self.held is None:
            self.touch.scroll(dx, dy)      # no fingers just lifted: Magic Mouse & co.
            return
        now = time.monotonic()
        if self.scale is None and self.wprev is not None and (dx or dy):
            # Match the speed at the hand-over: the fingers' last speed (units/s)
            # against macOS's first momentum steps (points/s).
            (t0, x0, y0), (t1, x1, y1) = self.hist[0], self.hist[-1]
            vf = math.hypot(x1 - x0, y1 - y0) / max(t1 - t0, 1e-3)
            vw = math.hypot(dx, dy) / max(now - self.wprev, 1e-3)
            self.scale = min(max(vf / vw, 1.0), 60.0) if vw > 0 else TOUCH_UNITS_PER_POINT
            if SCROLL_DEBUG:
                print(f"hand-over: fingers {vf:.0f} units/s, momentum {vw:.0f} pt/s, scale {self.scale:.1f}", flush=True)
        s = (self.scale or TOUCH_UNITS_PER_POINT) * GLIDE
        self.wprev = now
        self.pending[0] += dx * s
        self.pending[1] += dy * s
        self.moved = now
        self.drain()

    # Touchpad units per 4 ms tick: 400 = 4 mm = 1000 mm/s, under libinput's
    # touch-jump threshold (about 20 mm per 12 ms); fast flicks hand over at up
    # to ~550 mm/s, which a lower limit would throttle into a sluggish glide.
    MAX_STEP = int(os.environ.get("OMACVM_SCROLL_MAX_STEP", "400"))

    def drain(self):
        """Apply pending momentum in small, evenly timed steps."""
        if self.held is None or not (self.pending[0] or self.pending[1]):
            return
        now = time.monotonic()
        if now - self.tick < 0.004:
            return
        self.tick = now
        px, py = self.pending
        d = math.hypot(px, py)
        k = min(1.0, self.MAX_STEP / d) if d else 0.0
        sx, sy = px * k, py * k
        if not all(500 <= c[1] + sx <= PAD_W - 500 and 500 <= c[2] + sy <= PAD_H - 500 for c in self.held):
            self.pending = [0.0, 0.0]      # at the edge: stop here, lift after the hold
            return
        for c in self.held:
            c[1] += sx
            c[2] += sy
        self.pending = [px - sx, py - sy]
        self.pad.frame([(c[0], round(c[1]), round(c[2])) for c in self.held])

    def idle(self):
        self.pad.flush()
        self.touch.idle()
        if self.held is None:
            return
        self.drain()
        now = time.monotonic()
        if (self.moved < self.lifted and now - self.lifted > self.MOMENTUM_WAIT) or \
           (self.moved >= self.lifted and now - self.moved > TOUCH_LIFT_AFTER):
            self.pad.frame([])
            self.held = None


def make_keyboard():
    """A virtual keyboard for the Mac's Cmd shortcuts on UTM (sent as Super+key)."""
    return UInput({e.EV_KEY: list(range(1, 249))}, name="OmacVM keyboard (Mac shortcuts)")


class Keys:
    def __init__(self, ui):
        self.ui, self.down = ui, set()

    def key(self, code, value):
        if not 0 < code < 249:
            return
        self.ui.write(e.EV_KEY, code, value)
        self.ui.syn()
        if value:
            self.down.add(code)
        else:
            self.down.discard(code)

    def release(self):
        for code in list(self.down):
            self.key(code, 0)


def desktop_user():
    """OMACVM_GESTURES_USER, else the owner of the running Wayland session."""
    if USER:
        return USER
    for sock in glob.glob("/run/user/*/wayland-*"):
        if not sock.endswith(".lock"):
            return pwd.getpwuid(os.stat(sock).st_uid).pw_name
    return None


def notify(text):
    user = desktop_user()
    if not user:
        return
    uid = subprocess.run(["id", "-u", user], capture_output=True, text=True).stdout.strip()
    if not uid:
        return
    env = dict(os.environ, DBUS_SESSION_BUS_ADDRESS=f"unix:path=/run/user/{uid}/bus", XDG_RUNTIME_DIR=f"/run/user/{uid}")
    subprocess.Popen(["runuser", "-u", user, "--", "notify-send", "-a", "Trackpad", "-t", "2500", text],
                     env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run(pad, keys, wheel, touch, hybrid):
    with socket.create_connection((HOST, PORT), timeout=5) as s:
        s.settimeout(0.004)        # also the momentum's step clock
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        print(f"omacvm-gestures: connected to {HOST}:{PORT}", flush=True)
        buf = b""
        while True:
            try:
                data = s.recv(65536)
            except socket.timeout:
                hybrid.idle()
                continue
            hybrid.idle()
            if not data:
                raise ConnectionError("helper closed the connection")
            buf += data
            *lines, buf = buf.split(b"\n")
            for line in lines:
                p = line.split()
                if not p:
                    continue
                if p[0] == b"F":
                    n = int(p[1])
                    contacts = []
                    for i in range(n):
                        cid, x, y = int(p[2 + 4 * i]), float(p[3 + 4 * i]), float(p[4 + 4 * i])
                        contacts.append((cid, OFF_X + round(min(max(x, 0.0), 1.0) * W), OFF_Y + round(min(max(y, 0.0), 1.0) * H)))
                    if SCROLL_MODE == "touch":
                        hybrid.frame(contacts)
                    else:
                        pad.frame(contacts)
                elif p[0] == b"A":
                    hybrid.macos(float(p[1]), float(p[2]))
                elif p[0] == b"P":
                    hybrid.pinch()
                elif p[0] == b"W":
                    if SCROLL_DEBUG:
                        print(f"W {time.monotonic():.3f} {p[1].decode()} {p[2].decode()}", flush=True)
                    if SCROLL_MODE == "touch":
                        hybrid.momentum(float(p[1]), float(p[2]))
                    else:
                        wheel.scroll(float(p[1]), float(p[2]))
                elif p[0] == b"K":
                    keys.key(int(p[1]), int(p[2]))
                elif p[0] == b"S":
                    state = p[1].decode()
                    print(f"omacvm-gestures: capture {state}", flush=True)
                    if state != "on":
                        hybrid.held = None
                        pad.release()
                        keys.release()
                    if state == "esc":
                        notify("Trackpad gestures → macOS (⌃⌥⌘ Esc to take them back)")


def main():
    ui = make_device()
    pad = Touchpad(ui)
    keys = Keys(make_keyboard())
    wheel = Wheel(make_wheel())
    touch = TouchScroll(pad)
    hybrid = Hybrid(pad, touch)
    print(f"omacvm-gestures: virtual touchpad {ui.device.path}, scrolling as {SCROLL_MODE}", flush=True)
    while True:
        try:
            run(pad, keys, wheel, touch, hybrid)
        except (OSError, ConnectionError, ValueError, IndexError) as err:
            pad.release()
            keys.release()
            print(f"omacvm-gestures: {err}; retrying", file=sys.stderr, flush=True)
            time.sleep(2)


if __name__ == "__main__":
    main()
