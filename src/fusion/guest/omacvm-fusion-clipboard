#!/usr/bin/env python3
# omacvm-fusion-clipboard: text copy and paste between the Mac and Omarchy on
# VMware Fusion. VMware Tools' agent (vmware-user, dndcp plugin) exchanges an
# X11 clipboard with Fusion whenever the pointer enters or leaves the VM. On
# Hyprland's own X11 display (XWayland) that cannot work: Hyprland owns its
# clipboard and refuses X11 clients unless an X11 window has focus, and the
# agent has none. So the agent gets a private headless X display (Xvfb), and
# this syncs that display's clipboard with Wayland's: Wayland into X11 when it
# changes (wl-paste --watch), X11 into Wayland when the agent puts the Mac's
# text there (XFixes tells when the selection gets a new owner; polled every
# 0.5 s only if XFixes is missing). The agent sees a new copy by the selection's TIMESTAMP,
# which xsel answers (xclip answers it with the text). Text only. Runs in the
# desktop session (omacvm-fusion-clipboard.service), Xvfb and the agent as its
# children. The X display is its own, on a free number, and needs a cookie
# only the desktop user can read.
import ctypes, ctypes.util, hashlib, os, select, subprocess, threading, time


def own_display():
    n = 99
    while os.path.exists(f"/tmp/.X11-unix/X{n}") or os.path.exists(f"/tmp/.X{n}-lock"):
        n += 1
    return f":{n}"


DISPLAY = own_display()
AUTH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "omacvm-fusion-xauth")
open(AUTH, "w").close()
os.chmod(AUTH, 0o600)
subprocess.run(["xauth", "-q", "-f", AUTH, "add", DISPLAY, "MIT-MAGIC-COOKIE-1", os.urandom(16).hex()], check=True)
ENV = dict(os.environ, DISPLAY=DISPLAY, XAUTHORITY=AUTH)
last = None
lock = threading.Lock()

def digest(b):
    return hashlib.sha256(b).hexdigest()

def x11_get():
    try:
        r = subprocess.run(["xsel", "--clipboard", "--output"],
                           capture_output=True, timeout=2, env=ENV)
        return r.stdout if r.returncode == 0 else None
    except subprocess.TimeoutExpired:
        return None

def wayland_to_x11():
    global last
    # One line per change; the text itself is read separately (it may span lines).
    p = subprocess.Popen(["wl-paste", "--type", "text", "--watch", "echo", "changed"],
                         stdout=subprocess.PIPE, text=True, env=ENV)
    for _ in p.stdout:
        try:
            data = subprocess.run(["wl-paste", "--type", "text", "--no-newline"],
                                  capture_output=True, timeout=2, env=ENV).stdout
        except subprocess.TimeoutExpired:
            continue
        with lock:
            if not data or digest(data) == last:
                continue
            last = digest(data)
        subprocess.run(["xsel", "--clipboard", "--input"], input=data, env=ENV,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    raise SystemExit("wl-paste stopped")

class XEvent(ctypes.Union):
    _fields_ = [("type", ctypes.c_int), ("pad", ctypes.c_long * 24)]


def owner_changes():
    """A function that blocks until the X11 CLIPBOARD gets a new owner (or
    the agent sets it again), via XFixes. None when Xlib or XFixes cannot be
    used; then the caller polls."""
    try:
        x = ctypes.CDLL(ctypes.util.find_library("X11") or "libX11.so.6")
        xf = ctypes.CDLL(ctypes.util.find_library("Xfixes") or "libXfixes.so.3")
    except OSError:
        return None
    vp, ul = ctypes.c_void_p, ctypes.c_ulong
    x.XOpenDisplay.restype, x.XOpenDisplay.argtypes = vp, [ctypes.c_char_p]
    x.XDefaultRootWindow.restype, x.XDefaultRootWindow.argtypes = ul, [vp]
    x.XInternAtom.restype, x.XInternAtom.argtypes = ul, [vp, ctypes.c_char_p, ctypes.c_int]
    x.XConnectionNumber.argtypes = x.XPending.argtypes = x.XFlush.argtypes = [vp]
    x.XNextEvent.argtypes = [vp, ctypes.POINTER(XEvent)]
    xf.XFixesQueryExtension.argtypes = [vp, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
    xf.XFixesSelectSelectionInput.argtypes = [vp, ul, ul, ul]
    os.environ["XAUTHORITY"] = AUTH
    dpy = x.XOpenDisplay(DISPLAY.encode())
    base, err = ctypes.c_int(), ctypes.c_int()
    if not dpy or not xf.XFixesQueryExtension(dpy, ctypes.byref(base), ctypes.byref(err)):
        return None
    xf.XFixesSelectSelectionInput(dpy, x.XDefaultRootWindow(dpy), x.XInternAtom(dpy, b"CLIPBOARD", 0),
                                  1)   # XFixesSetSelectionOwnerNotifyMask
    x.XFlush(dpy)
    fd, ev = x.XConnectionNumber(dpy), XEvent()

    def wait():
        while True:
            seen = False
            while x.XPending(dpy):
                x.XNextEvent(dpy, ctypes.byref(ev))
                seen = seen or ev.type == base.value   # XFixesSelectionNotify
            if seen:
                return
            select.select([fd], [], [])
    return wait


def x11_to_wayland():
    global last
    wait = owner_changes()
    time.sleep(0.5)   # once without waiting: the agent may have set it already
    while True:
        data = x11_get()
        with lock:
            fresh = bool(data) and digest(data) != last
            if fresh:
                last = digest(data)
        if fresh:
            subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"], input=data, env=ENV)
        wait() if wait else time.sleep(0.5)

subprocess.Popen(["Xvfb", DISPLAY, "-auth", AUTH, "-nolisten", "tcp", "-nolisten", "local",
                  "-screen", "0", "1024x768x24"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
for _ in range(50):
    if os.path.exists("/tmp/.X11-unix/X" + DISPLAY.lstrip(":")):
        break
    time.sleep(0.1)
subprocess.Popen(["vmware-user-suid-wrapper"], env=ENV, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
threading.Thread(target=wayland_to_x11, daemon=True).start()
x11_to_wayland()
