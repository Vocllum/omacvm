#!/usr/bin/env python3
# omacvm-fusion-displays: Hyprland follows VMware Fusion's display layout.
# Fusion sends its layout through VMware Tools (resolutionKMS) to vmwgfx: one
# output per Mac display in full screen, the window size in a window. Hyprland
# sees the outputs come and go but ignores their suggested positions, so this
# applies them (and each output's mode) whenever the driver reports a change
# and whenever Hyprland reloads its config (which drops runtime monitor rules).
# Runs in the desktop session (omacvm-fusion-displays.service).
import os, re, select, socket, subprocess, time

HERE = os.path.dirname(os.path.realpath(__file__))
LAYOUT = os.path.join(HERE, "omacvm-fusion-layout")
MONITORS = os.path.expanduser("~/.config/hypr/monitors.lua")
last = None

def log(msg):
    print(msg, flush=True)

def scale_for(width):
    # What Omarchy's scaling menu wrote, else 2 on a Retina-size output.
    try:
        m = re.search(r"^local omarchy_monitor_scale = ([0-9.]+)", open(MONITORS).read(), re.M)
        if m:
            return m.group(1)
    except OSError:
        pass
    return "2" if width >= 3000 else "1"

def apply(force=False):
    global last
    try:
        out = subprocess.run([LAYOUT], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"layout: {e}")
        return
    rows = [r.split() for r in out.splitlines() if len(r.split()) == 5]
    if not rows or (rows == last and not force):
        return
    for name, x, y, w, h in rows:
        rule = f'hl.monitor{{output="{name}", mode="{w}x{h}", position="{x}x{y}", scale={scale_for(int(w))}}}'
        subprocess.run(["hyprctl", "eval", rule], capture_output=True, timeout=10)
    last = rows
    log("layout: " + ", ".join(f"{n} {w}x{h} at {x},{y}" for n, x, y, w, h in rows))

def hypr_events():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "hypr", sig, ".socket2.sock")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(path)
    return s

udev = subprocess.Popen(["udevadm", "monitor", "--kernel", "--subsystem-match=drm"],
                        stdout=subprocess.PIPE, text=True, bufsize=1)
hypr = hypr_events()
apply(force=True)
buf = ""
while True:
    ready, _, _ = select.select([udev.stdout, hypr], [], [])
    changed = False
    if udev.stdout in ready:
        line = udev.stdout.readline()
        if not line:
            raise SystemExit("udevadm stopped")
        changed = "change" in line
    if hypr in ready:
        data = hypr.recv(4096).decode(errors="replace")
        if not data:
            raise SystemExit("Hyprland's event socket closed")
        buf += data
        *events, buf = buf.split("\n")
        if any(e.startswith(("configreloaded>>", "monitoradded>>", "monitoraddedv2>>")) for e in events):
            changed = True
    if changed:
        time.sleep(0.3)   # one layout change arrives as several events
        apply(force=True)
