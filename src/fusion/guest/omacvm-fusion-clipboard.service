[Unit]
Description=OmacVM: copy and paste between the Mac and Omarchy (VMware Fusion)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/share/omacvm/fusion/guest/omacvm-fusion-clipboard
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
