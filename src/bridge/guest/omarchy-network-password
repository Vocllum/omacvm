#!/bin/bash
# OmacVM: the "show password" of Omarchy's Wi-Fi QR card for the Mac's
# Wi-Fi (interface "mac", see omarchy-network-qr); macOS asks for approval.
# Any other interface is Omarchy's own /usr/bin/omarchy-network-password.
set -euo pipefail
[[ ${1:-} == mac ]] || exec /usr/bin/omarchy-network-password "$@"
json=$(omacvm-bridge password 2>/dev/null) || {
  [[ $(jq -r '.error // empty' <<<"$json" 2>/dev/null) == denied ]] && echo "Declined on the Mac" >&2 || echo "Could not read the Wi-Fi password" >&2
  exit 1
}
password=$(jq -r '.password // empty' <<<"$json")
[[ -n $password ]] || { echo "This network has no password" >&2; exit 1; }
printf '%s\n' "$password"   # stdout is the card's private pipe; never an argument
