#!/bin/bash
# OmacVM: Omarchy's Wi-Fi QR card (omarchy.wifiqr) for the Mac's Wi-Fi.
# The VM has no Wi-Fi of its own. When NetworkManager has no connected Wi-Fi
# device (or the card asks for interface "mac"), this shares the Mac's current
# network through the bridge; macOS asks for approval first. Otherwise it is
# Omarchy's own /usr/bin/omarchy-network-qr. Same output: an optional
# "meta<TAB>iface<TAB>security<TAB>ssid" line, then a 0/1 module matrix.
set -euo pipefail
iface=""; meta=false
for a in "$@"; do case $a in --meta) meta=true ;; *) iface=$a ;; esac; done
if [[ $iface != mac ]] && LC_ALL=C nmcli -t -f TYPE,STATE device status 2>/dev/null | grep -q '^wifi:connected'; then
  exec /usr/bin/omarchy-network-qr "$@"
fi
if ! json=$(omacvm-bridge password 2>/dev/null); then
  case $(jq -r '.error // empty' <<<"$json" 2>/dev/null) in
    denied) echo "Sharing was declined on the Mac" >&2 ;;
    *802.1X*|*enterprise*) echo "Enterprise Wi-Fi cannot be shared with a password QR code" >&2 ;;
    "") echo "The Mac's Wi-Fi could not be read" >&2 ;;
    *) jq -r .error <<<"$json" >&2 ;;
  esac
  exit 1
fi
qr=$(jq -r .qr <<<"$json"); ssid=$(jq -r .ssid <<<"$json")
security=$(sed -n 's/^WIFI:T:\([^;]*\);.*/\1/p' <<<"$qr"); [[ $security == SAE ]] && security=WPA
$meta && printf 'meta\tmac\t%s\t%s\n' "$security" "$ssid"
ascii=$(printf '%s' "$qr" | qrencode --type ASCII --margin 4 --output -)
while IFS= read -r line; do
  row=
  for ((column = 0; column < ${#line}; column += 2)); do
    [[ ${line:column:2} == *#* ]] && row+=1 || row+=0
  done
  printf '%s\n' "$row"
done <<<"$ascii"
