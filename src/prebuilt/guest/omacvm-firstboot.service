[Unit]
Description=OmacVM: first boot of a prebuilt VM (user, keys, keyboard, timezone)
ConditionPathExists=/var/lib/omacvm/prebuilt/pending
After=local-fs.target systemd-udevd.service systemd-tmpfiles-setup.service
Before=display-manager.service sddm.service systemd-user-sessions.service getty@tty1.service sshd.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/omacvm/omacvm-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutSec=0

[Install]
WantedBy=multi-user.target
