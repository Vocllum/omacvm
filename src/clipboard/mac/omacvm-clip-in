#!/bin/zsh
# omacvm-clip-in: put text copied inside the Omarchy VM on the Mac clipboard.
# Parallels Tools syncs Mac -> guest on Hyprland but not guest -> Mac, so the
# guest writes each copied text to the Parallels shared folder "clip" and this
# picks it up.
# The check runs every 0.3 s on zsh builtins (stat and sleep), so it starts no
# process until something was copied.
export LC_CTYPE=UTF-8
zmodload zsh/system; zmodload -F zsh/stat b:zstat; zmodload zsh/zselect
f="$HOME/.local/share/omacvm/clip/guest-clipboard"
MAX=4194304   # 4 MiB

# The guest can write that folder: read only a plain file there, never
# through a link (it could point at any file on the Mac), and at most MAX.
read_clip() {
  local fd m r
  sysopen -r -o nofollow,nonblock -u fd "$f" 2>/dev/null || return 1
  zstat -A m -s +mode -f $fd 2>/dev/null
  if [[ $m == -* ]]; then head -c $MAX <&$fd; r=$?; else r=1; fi
  exec {fd}<&-
  return $r
}

typeset -A s
# The guest replaces the file (write, then rename), so its inode changes with
# every copy; mtime and size cover an in-place write.
# Sets REPLY (no $(...), which would fork).
stamp() { REPLY=; zstat -L -H s -- "$f" 2>/dev/null && REPLY="$s[inode] $s[mtime] $s[size]"; }
stamp; last=$REPLY   # ignore whatever is there at start
while true; do
  zselect -t 30
  stamp || continue
  [[ "$REPLY" == "$last" ]] && continue
  last=$REPLY
  new="$(read_clip)" || continue
  [[ -n "$new" && "$new" != "$(pbpaste)" ]] && read_clip | pbcopy
done
