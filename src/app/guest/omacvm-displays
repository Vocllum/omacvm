#!/usr/bin/python3
"""OmacVM.app: Omarchy on every Mac display.

In full screen, OmacVM.app opens a window on every Mac display and gives the
VM one output per display (Virtual-1 is the main window, Virtual-2 ... the
others). This agent is the VM's side of that, over the virtio port
org.omacvm.display, one JSON object per line:

  from the Mac  {"layout": [{"output": "Virtual-2", "x": 1728, "y": 0,
                 "width": 1920, "height": 1080, "scale": 1}, ...],
                 "external": true, "fullscreen": true, "builtin": "Virtual-2"}
                where each output sits in the Mac's arrangement (points);
                "builtin" names the output on the Mac's own display (the
                notch), when one is;
  to the Mac    {"hello": 1, "external": true}  when it starts,
                {"external": false}             when the switch changes,
                {"monitors": [{"name": "Virtual-1", "x": 0, "y": 0,
                 "width": 1728, "height": 1085}, ...]}
                where Hyprland put its outputs (logical pixels), so the
                Mac points the pointer at the right one.

The layout goes to $XDG_RUNTIME_DIR/omacvm/displays.json, where
omacvm-display-sync takes the positions from, and the built-in display's
output to $XDG_RUNTIME_DIR/omacvm/builtin (missing: none of them), which
Omanotch follows.

The switch "Use external displays" is ~/.config/omacvm/displays.conf
(external=on or off; on when missing):

  omacvm-displays                   run the agent (the user service)
  omacvm-displays external on|off|toggle
  omacvm-displays state             "on" or "off" (nothing without the port)
  omacvm-displays status            the switch and the outputs, as JSON
  omacvm-displays layers            displays whose wallpaper is not on them

Outputs move when Mac displays come and go. Hyprland leaves a mapped layer
surface at its old place when its output moves, and Omarchy's remap for that
never fires on Quickshell, so a display can end up without wallpaper or bar
(only Hyprland's dark grey; a shell restart fixed it). The agent checks where
the wallpaper layers are once the layout has settled, and when one is still
off its display a few seconds later, it restarts the shell (at most every
2 minutes, 3 times per session, and not again when a restart changed
nothing; repair-shell=off in displays.conf turns that off, the check and its
log line stay). Omanotch's patched bar and wallpaper
remap themselves; this also covers Omarchy's own.

The switch also sits in Omarchy's display panel (the bar widget
omacvm.monitor, built from Omarchy's own by monitor-widget/build.py; rebuilt
here when Omarchy's panel changes with an update).
"""

from __future__ import annotations

import errno
import json
import os
from pathlib import Path
import re
import select
import socket
import subprocess
import sys
import time

PORT = Path("/dev/virtio-ports/org.omacvm.display")
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omacvm/displays.conf"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
STATE = RUNTIME / "omacvm/displays.json"
BUILTIN = RUNTIME / "omacvm/builtin"
SYNC = "/usr/local/bin/omacvm-display-sync"
WIDGET = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy/plugins/omacvm.monitor"
WIDGET_BUILD = Path("/usr/local/share/omacvm/app/guest/monitor-widget/build.py")
OMARCHY_PANEL = Path("/usr/share/omarchy/shell/plugins/panels/monitor/Panel.qml")


def log(message: str) -> None:
    print(f"omacvm-displays: {message}", file=sys.stderr, flush=True)


def config_flag(name: str) -> bool:
    """A displays.conf switch; on when missing."""
    try:
        for line in CONFIG.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() == name:
                return value.strip().lower() not in ("off", "0", "no", "false")
    except OSError:
        pass
    return True


def external_on() -> bool:
    return config_flag("external")


def set_external(on: bool) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(f"external={'on' if on else 'off'}\n")
    tmp.replace(CONFIG)


def config_mtime() -> float:
    try:
        return CONFIG.stat().st_mtime
    except OSError:
        return 0.0


def hypr_dir() -> Path | None:
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    base = RUNTIME / "hypr"
    if sig and (base / sig).is_dir():
        return base / sig
    try:
        dirs = [d for d in base.iterdir() if (d / ".socket.sock").exists()]
    except OSError:
        return None
    return max(dirs, key=lambda d: d.stat().st_mtime) if dirs else None


def hypr_request(command: str) -> str | None:
    d = hypr_dir()
    if not d:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2)
            s.connect(str(d / ".socket.sock"))
            s.sendall(command.encode())
            chunks = []
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
        return b"".join(chunks).decode(errors="replace")
    except OSError:
        return None


def hypr_json(command: str):
    reply = hypr_request(command)
    if reply is None:
        return None
    try:
        return json.loads(reply)
    except ValueError:
        return None


def logical_monitors(data) -> list[dict]:
    """Enabled outputs from j/monitors, in logical pixels."""
    out = []
    for m in data if isinstance(data, list) else []:
        if not isinstance(m, dict) or m.get("disabled"):
            continue
        try:
            scale = float(m.get("scale") or 1) or 1.0
            w, h = m.get("width", 0) / scale, m.get("height", 0) / scale
        except (TypeError, ValueError):
            continue
        if m.get("transform", 0) % 2:
            w, h = h, w
        out.append({"name": m.get("name", ""), "x": m.get("x", 0), "y": m.get("y", 0),
                    "width": round(w, 3), "height": round(h, 3)})
    return sorted(out, key=lambda m: m["name"])


def monitors() -> list[dict] | None:
    """Hyprland's outputs in logical pixels, as its absolute pointer sees them."""
    data = hypr_json("j/monitors")
    return None if data is None else logical_monitors(data)


WALLPAPER = "omarchy-background"


def misplaced_wallpapers(monitors_data, layers_data) -> list[str]:
    """Mac displays (Virtual-N) whose wallpaper layer is not where they are.

    monitors_data is Hyprland's j/monitors, layers_data its j/layers (layer
    boxes in the same global logical coordinates). Nothing is reported while
    the shell has no wallpaper layer at all (not running yet, or no Omarchy
    shell), for an output without one, or for outputs that mirror another.
    """
    if not isinstance(layers_data, dict):
        return []
    boxes: dict[str, list[tuple]] = {}
    for name, entry in layers_data.items():
        levels = entry.get("levels") if isinstance(entry, dict) else None
        for level in (levels.values() if isinstance(levels, dict) else []):
            for layer in level if isinstance(level, list) else []:
                if isinstance(layer, dict) and layer.get("namespace") == WALLPAPER:
                    boxes.setdefault(name, []).append(
                        tuple(layer.get(k, 0) for k in ("x", "y", "w", "h")))
    if not boxes:
        return []
    mirrors = {m.get("name") for m in monitors_data if isinstance(m, dict)
               and m.get("mirrorOf") not in (None, "", "none")} if isinstance(monitors_data, list) else set()
    problems = []
    for m in logical_monitors(monitors_data):
        name = m["name"]
        if not re.fullmatch(r"Virtual-[0-9]+", name) or name in mirrors:
            continue
        want = (m["x"], m["y"], m["width"], m["height"])
        have = boxes.get(name, [])
        # No wallpaper layer at all is left alone: the shell may be making it,
        # or have it unmapped on purpose (a remap, the lock screen).
        # Rounding at fractional scales: a pixel or two either way.
        if not have or any(all(abs(float(a) - float(b)) <= 2 for a, b in zip(box, want))
                           for box in have):
            continue
        where = ", ".join(f"{b[0]},{b[1]} {b[2]}x{b[3]}" for b in have)
        problems.append(f"{name}: wallpaper at {where}, display at "
                        f"{want[0]},{want[1]} {round(want[2])}x{round(want[3])}")
    return problems


def run_sync() -> None:
    try:
        subprocess.run([SYNC, "--once"], timeout=20, check=False,
                       stdout=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f"display sync failed: {error}")


def refresh_widget() -> None:
    """Rebuild omacvm.monitor when an Omarchy update changed its display panel."""
    stamp = WIDGET / ".source-sha256"
    if not stamp.exists() or not WIDGET_BUILD.exists() or not OMARCHY_PANEL.exists():
        return
    import hashlib
    digest = hashlib.sha256(OMARCHY_PANEL.read_bytes()).hexdigest()
    if stamp.read_text().strip() == digest:
        return
    try:
        subprocess.run([sys.executable, str(WIDGET_BUILD), str(WIDGET)], timeout=30, check=True)
        subprocess.run(["omarchy-shell", "-q", "shell", "rescanPlugins"], timeout=30, check=False)
        log("display widget rebuilt for the updated Omarchy")
    except (OSError, subprocess.SubprocessError) as error:
        log(f"display widget not rebuilt: {error}")


def write_state(message: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(message) + "\n")
    tmp.replace(STATE)
    builtin = message.get("builtin")
    if isinstance(builtin, str) and re.fullmatch(r"Virtual-[0-9]+", builtin):
        tmp = BUILTIN.with_suffix(".tmp")
        tmp.write_text(builtin + "\n")
        tmp.replace(BUILTIN)
    else:
        BUILTIN.unlink(missing_ok=True)


REPAIRS = RUNTIME / "omacvm/shell-repairs"
REPAIR_EVERY = 120.0   # seconds between two shell restarts
REPAIR_MAX = 3         # per run of the agent (a session)
SETTLE = 3.0           # seconds without a layout change before checking
CONFIRM = 4.0          # the same problem again after this long: repair


class Agent:
    def __init__(self) -> None:
        self.fd = os.open(PORT, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
        self.buffer = b""
        self.outbox = b""
        self.external = external_on()
        self.mtime = config_mtime()
        self.reported: list[dict] | None = None
        self.events: socket.socket | None = None
        self.check_at = 0.0
        self.last_check = 0.0
        self.layout_at = time.monotonic()
        self.suspect: tuple[list[str], float] | None = None
        self.repairs = 0
        self.repaired_at = -REPAIR_EVERY
        self.repair: subprocess.Popen | None = None
        self.repaired_for: list[str] = []
        self.said: list[str] = []

    def send(self, message: dict) -> None:
        self.outbox += json.dumps(message, separators=(",", ":")).encode() + b"\n"
        self.flush()

    def flush(self) -> None:
        while self.outbox:
            try:
                n = os.write(self.fd, self.outbox)
            except OSError as error:
                if error.errno in (errno.EAGAIN, errno.EINTR):
                    return
                raise
            self.outbox = self.outbox[n:]

    def connect_events(self) -> None:
        d = hypr_dir()
        if not d or self.events:
            return
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(str(d / ".socket2.sock"))
            s.setblocking(False)
            self.events = s
        except OSError:
            self.events = None

    def soon(self, delay: float) -> None:
        when = time.monotonic() + delay
        if not self.check_at or when < self.check_at:
            self.check_at = when

    def report(self) -> None:
        current = monitors()
        if current is not None and current != self.reported:
            self.reported = current
            self.send({"monitors": current})

    def layout_changed(self) -> None:
        self.layout_at = time.monotonic()
        self.suspect = None

    def check_wallpapers(self) -> None:
        """Restarts the shell when a wallpaper stays off its display."""
        now = time.monotonic()
        if self.repair and self.repair.poll() is None:
            return  # a restart is under way
        if now - self.layout_at < SETTLE:
            return
        problems = misplaced_wallpapers(hypr_json("j/monitors"), hypr_json("j/layers"))
        if not problems:
            self.suspect = None
            return
        if not self.suspect or self.suspect[0] != problems:
            self.suspect = (problems, now)
            return
        if now - self.suspect[1] < CONFIRM:
            return
        self.suspect = None
        detail = "; ".join(problems)
        say = problems != self.said  # one log line per distinct problem
        self.said = problems
        if not config_flag("repair-shell"):
            if say:
                log(f"wallpaper off its display ({detail}); repair-shell=off")
            return
        if problems == self.repaired_for:
            # Exactly the same after a fresh shell: not a surface left
            # behind (or Hyprland reports layers differently). Stop here.
            if self.repairs < REPAIR_MAX:
                log(f"wallpaper still off its display after a shell restart ({detail}); "
                    "not restarting it again")
            self.repairs = REPAIR_MAX
            return
        if self.repairs >= REPAIR_MAX or now - self.repaired_at < REPAIR_EVERY:
            if say:
                log(f"wallpaper off its display ({detail}); not restarting the shell again yet")
            return
        self.repairs += 1
        self.repaired_for = problems
        self.repaired_at = now
        log(f"wallpaper off its display ({detail}): restarting the shell")
        try:  # for omacvm check
            REPAIRS.parent.mkdir(parents=True, exist_ok=True)
            REPAIRS.write_text(json.dumps({"count": self.repairs, "at": time.time(),
                                           "why": problems}) + "\n")
        except OSError:
            pass
        try:
            self.repair = subprocess.Popen(["omarchy-restart-shell"], stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL)
        except OSError as error:
            log(f"shell restart failed: {error}")

    def on_line(self, line: bytes) -> None:
        try:
            message = json.loads(line)
        except ValueError:
            return
        if not isinstance(message, dict) or not isinstance(message.get("layout"), list):
            return
        write_state(message)
        run_sync()
        self.layout_changed()
        self.soon(0.3)

    def run(self) -> None:
        self.send({"hello": 1, "external": self.external})
        while True:
            self.connect_events()
            readers = [self.fd] + ([self.events] if self.events else [])
            writers = [self.fd] if self.outbox else []
            now = time.monotonic()
            # A report at least every 5 s, in case an event slipped by.
            timeout = 1.0 if not self.check_at else max(0.0, min(1.0, self.check_at - now))
            ready, writable, _ = select.select(readers, writers, [], timeout)
            if writable:
                self.flush()
            if self.fd in ready:
                try:
                    data = os.read(self.fd, 65536)
                except OSError as error:
                    if error.errno not in (errno.EAGAIN, errno.EINTR):
                        raise
                    data = None
                if data:
                    self.buffer += data
                    while b"\n" in self.buffer:
                        line, self.buffer = self.buffer.split(b"\n", 1)
                        self.on_line(line)
                    if len(self.buffer) > 1 << 20:
                        self.buffer = b""
                elif data == b"":
                    # The Mac side is not connected (yet): say hello again
                    # once it is, so it sends the layout.
                    if b'"hello"' not in self.outbox:
                        self.send({"hello": 1, "external": self.external})
                    time.sleep(1)
            if self.events and self.events in ready:
                try:
                    data = self.events.recv(65536)
                except OSError:
                    data = b""
                if not data:
                    self.events.close()
                    self.events = None
                elif b"monitor" in data or b"configreloaded" in data:
                    self.layout_changed()
                    self.soon(0.3)
            mtime = config_mtime()
            if mtime != self.mtime:
                self.mtime = mtime
                on = external_on()
                if on != self.external:
                    self.external = on
                    self.send({"external": on})
            now = time.monotonic()
            if (self.check_at and now >= self.check_at) or now - self.last_check >= 5:
                self.check_at = 0.0
                self.last_check = now
                self.report()
                self.check_wallpapers()


def notify(text: str) -> None:
    try:
        subprocess.run(["notify-send", "-a", "OmacVM", "-t", "2500", text],
                       timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[1] == "external":
        want = argv[2] if len(argv) > 2 else "toggle"
        if want not in ("on", "off", "toggle"):
            print("usage: omacvm-displays external on|off|toggle", file=sys.stderr)
            return 2
        on = (not external_on()) if want == "toggle" else want == "on"
        set_external(on)
        notify("External displays: " + ("on (in full screen)" if on else "off"))
        return 0
    if len(argv) >= 2 and argv[1] == "state":
        if PORT.exists():
            print("on" if external_on() else "off")
        return 0
    if len(argv) >= 2 and argv[1] == "status":
        layout = None
        try:
            layout = json.loads(STATE.read_text())
        except (OSError, ValueError):
            pass
        print(json.dumps({"external": external_on(), "port": PORT.exists(),
                          "layout": layout, "monitors": monitors()}, indent=2))
        return 0
    if len(argv) >= 2 and argv[1] == "layers":
        repairs = None
        try:
            repairs = json.loads(REPAIRS.read_text())
        except (OSError, ValueError):
            pass
        print(json.dumps({"misplaced": misplaced_wallpapers(hypr_json("j/monitors"),
                                                            hypr_json("j/layers")),
                          "repairs": repairs}, indent=2))
        return 0
    if len(argv) >= 2 and argv[1] not in ("run",):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if not PORT.exists():
        log(f"{PORT} is missing (an OmacVM.app without external displays)")
        return 0
    refresh_widget()
    Agent().run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
