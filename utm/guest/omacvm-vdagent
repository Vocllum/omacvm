#!/usr/bin/env python3
"""omacvm-vdagent: UTM's SPICE session agent for Hyprland (clipboard + pointer).

UTM's SPICE client talks to spice-vdagentd over the virtio port; the daemon
serves one session agent over /run/spice-vdagentd/spice-vdagent-sock (the
"udscs" protocol). The stock agent (spice-vdagent) is X11-only: under
Hyprland it runs on XWayland, sees every output (with Omanotch also the notch
strip) side by side and reports a screen twice as wide as the real one.
vdagentd sizes its absolute pointer ("spice vdagent tablet") from that report,
so the Mac's pointer then only reaches the left half of the screen.

This agent reports the real display (the largest Hyprland monitor) and moves
text between the Mac's clipboard and Wayland's with wl-copy / wl-paste.

Based on omarchy-arm-vdagent by ggalancs (https://github.com/ggalancs/omarchy-arm-utm),
MIT licence.
"""
import json, os, socket, struct, subprocess, sys, threading, time, signal

SOCK = os.environ.get("VDAGENTD_SOCK", "/run/spice-vdagentd/spice-vdagent-sock")

# vdagentd-proto.h
GUEST_XORG_RESOLUTION = 0
CLIPBOARD_GRAB = 2
CLIPBOARD_REQUEST = 3
CLIPBOARD_DATA = 4
VERSION = 6
SEL_CLIPBOARD = 0  # VD_AGENT_CLIPBOARD_SELECTION_CLIPBOARD
TYPE_UTF8 = 1      # VD_AGENT_CLIPBOARD_UTF8_TEXT
DEBUG = bool(os.environ.get("OMACVM_VDAGENT_DEBUG"))


def log(*a):
    print("omacvm-vdagent:", *a, file=sys.stderr, flush=True)


def read_clipboard():
    try:
        r = subprocess.run(["wl-paste", "--no-newline", "--type", "text/plain"],
                           capture_output=True, timeout=5)
        return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else None
    except Exception:
        return None


def write_clipboard(text):
    try:
        subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"],
                       input=text.encode("utf-8"), timeout=5)
    except Exception as e:
        log("wl-copy failed:", e)


def resolution():
    """Pixel size of the real display. Waits for Hyprland; the largest monitor
    wins, so helper outputs (Omanotch's notch strip) never count."""
    while True:
        try:
            r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, timeout=4)
            mons = json.loads(r.stdout) if r.returncode == 0 else []
            if mons:
                m = max(mons, key=lambda m: m["width"] * m["height"])
                return int(m["width"]), int(m["height"])
        except Exception:
            pass
        time.sleep(2)


class Agent:
    def __init__(self, sock):
        self.s = sock
        self.lock = threading.Lock()
        self.last = read_clipboard()

    def send(self, kind, a1=0, a2=0, data=b""):
        if DEBUG:
            log("->", kind, a1, a2, len(data))
        with self.lock:
            self.s.sendall(struct.pack("<IIII", kind, a1, a2, len(data)) + data)

    def _read(self, n):
        b = b""
        while len(b) < n:
            t = self.s.recv(n - len(b))
            if not t:
                raise EOFError
            b += t
        return b

    def loop(self):
        while True:
            kind, a1, a2, size = struct.unpack("<IIII", self._read(16))
            data = self._read(size) if size else b""
            if DEBUG:
                log("<-", kind, a1, a2, size)
            if kind == CLIPBOARD_GRAB:          # the Mac copied something
                self.send(CLIPBOARD_REQUEST, SEL_CLIPBOARD, TYPE_UTF8)
            elif kind == CLIPBOARD_REQUEST:     # the Mac pastes ours
                self.send(CLIPBOARD_DATA, SEL_CLIPBOARD, TYPE_UTF8,
                          (read_clipboard() or "").encode("utf-8"))
            elif kind == CLIPBOARD_DATA and a2 == TYPE_UTF8:
                self.last = data.decode("utf-8", "replace")
                write_clipboard(self.last)
            elif kind == VERSION:
                log("vdagentd", data.decode("utf-8", "replace").strip("\0 \n"))

    def watch(self):
        """Offer the Mac whatever is copied in Omarchy (wl-paste --watch prints
        a line on every selection change)."""
        p = subprocess.Popen(["wl-paste", "--watch", "echo"], stdout=subprocess.PIPE)
        for _ in p.stdout:
            t = read_clipboard()
            if t and t != self.last:
                self.last = t
                self.send(CLIPBOARD_GRAB, SEL_CLIPBOARD, 0, struct.pack("<I", TYPE_UTF8))


def main():
    while not os.path.exists(SOCK):  # spice-vdagentd not up yet
        time.sleep(2)
    w, h = resolution()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    ag = Agent(s)
    # struct vdagentd_guest_xorg_resolution: width, height, x, y, display_id;
    # the header carries the whole screen's size, which sizes the pointer.
    ag.send(GUEST_XORG_RESOLUTION, w, h, struct.pack("<iiiii", w, h, 0, 0, 0))
    log(f"display {w}x{h}")
    threading.Thread(target=ag.watch, daemon=True).start()
    try:
        ag.loop()
    except (EOFError, OSError) as e:
        log("vdagentd went away:", e)
    return 1  # systemd restarts us


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    sys.exit(main())
