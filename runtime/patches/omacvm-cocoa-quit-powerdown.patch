From: OmacVM
Subject: [PATCH] cocoa: Quit shuts the guest down

Quit and the close button press the guest's power button instead of
stopping it. Asking again within a minute offers to stop it at once.
Applies after omacvm-cocoa-identity.patch.

--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -2064,19 +2064,35 @@
     }
 }
 
-/* Verifies if the user really wants to quit */
+/*
+ * OmacVM: Quit and the close button shut the guest down like its power
+ * button; QEMU exits when the guest has powered off. Asking again while that
+ * runs offers to stop the VM at once.
+ */
+static NSDate *powerdownRequested;
+
 - (BOOL)verifyQuit
 {
-    NSAlert *alert = [NSAlert new];
-    [alert autorelease];
-    [alert setMessageText: [NSString stringWithFormat:@"Are you sure you want to quit %@?", omacvm_product_name()]];
-    [alert addButtonWithTitle: @"Cancel"];
-    [alert addButtonWithTitle: @"Quit"];
-    if([alert runModal] == NSAlertSecondButtonReturn) {
+    if (!runstate_is_running()) {
         return YES;
-    } else {
+    }
+    if (!powerdownRequested ||
+        [[NSDate date] timeIntervalSinceDate:powerdownRequested] > 60) {
+        [powerdownRequested release];
+        powerdownRequested = [[NSDate date] retain];
+        with_bql(^{
+            qemu_system_powerdown_request();
+        });
+        [[cocoaView window] setTitle:[NSString stringWithFormat:@"%@ (shutting down)", omacvm_product_name()]];
         return NO;
     }
+    NSAlert *alert = [NSAlert new];
+    [alert autorelease];
+    [alert setMessageText: [NSString stringWithFormat:@"%@ is shutting down.", omacvm_product_name()]];
+    [alert setInformativeText: @"Stop it now? Anything not saved in the VM is lost."];
+    [alert addButtonWithTitle: @"Wait"];
+    [alert addButtonWithTitle: @"Stop Now"];
+    return [alert runModal] == NSAlertSecondButtonReturn;
 }
 
 /* The action method for the About menu item */
