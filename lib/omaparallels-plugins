#!/bin/bash
# Enable the Omaparallels bar widgets queued in ~/.local/state/omaparallels/pending-plugins
# once the Omarchy shell answers. Run as the desktop user (at login by
# omaparallels-plugins.service, or directly by lib/install-plugin.sh).
set -uo pipefail
Q=${XDG_STATE_HOME:-$HOME/.local/state}/omaparallels/pending-plugins
[[ -s $Q ]] || exit 0
for _ in $(seq 60); do omarchy-shell shell ping >/dev/null 2>&1 && break; sleep 1; done
omarchy-shell -q shell rescanPlugins
left=()
while read -r id; do
  [[ -n $id ]] || continue
  dir=$HOME/.config/omarchy/plugins/$id
  if [[ -x $dir/placement.sh ]]; then (cd "$dir" && ./placement.sh) && ok=1 || ok=0
  else omarchy plugin enable "$id" >/dev/null && ok=1 || ok=0; fi
  if (( ok )); then echo "plugin $id enabled"; else left+=("$id"); fi
done < "$Q"
printf '%s\n' "${left[@]}" | grep . > "$Q.new" || true
mv "$Q.new" "$Q"
