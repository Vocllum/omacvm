[Unit]
Description=omarchy-notch-bar: stream the Omarchy bar to the macOS notch helper
Documentation=https://github.com/gillesgoetsch/omarchy-notch-bar
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/notchcast
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
