#!/bin/bash
# omaparallels-bridge (guest side): small client for the Mac helper (tools/omaparallels-bridge/mac).
#   omaparallels-bridge state | scan [--cached] | audio | events
#   omaparallels-bridge volume +5 | -5 | 40        percent; +/- = relative, unmutes when raising
#   omaparallels-bridge mute [on|off|toggle]       default: toggle
#   omaparallels-bridge mic-volume 60 | mic-mute [on|off|toggle]
#   omaparallels-bridge output <uid> | input <uid> (UIDs: omaparallels-bridge audio | jq '.devices')
# Env: OMAPARALLELS_BRIDGE_URL (default http://10.211.55.2:47831),
#      OMAPARALLELS_BRIDGE_TOKEN_FILE (default ~/.config/omaparallels-bridge/token)
set -euo pipefail
URL=${OMAPARALLELS_BRIDGE_URL:-http://10.211.55.2:47831}
TOKEN_FILE=${OMAPARALLELS_BRIDGE_TOKEN_FILE:-$HOME/.config/omaparallels-bridge/token}

# The token goes in via a header file, so it never shows up in `ps`.
req() { curl -sS --fail-with-body -H @<(printf 'Authorization: Bearer %s\n' "$(<"$TOKEN_FILE")") "$@"; echo; }
post() { req -X POST -H 'Content-Type: application/json' -d "$2" "$URL$1"; }
frac() { awk -v p="$1" 'BEGIN { printf "%.4f", p / 100 }'; }
check_mute() { [[ ${1:-toggle} =~ ^(on|off|toggle)$ ]] || { echo "mute: on, off or toggle" >&2; exit 2; }; }
mute_json() {
  case ${1:-toggle} in on) echo true ;; off) echo false ;; *) echo '"toggle"' ;; esac
}
check_percent() { [[ $1 =~ ^[+-]?[0-9]+(\.[0-9]+)?$ ]] || { echo "volume: a number in percent, e.g. +5, -5 or 40" >&2; exit 2; }; }
volume_json() {
  case $1 in
    +*|-*) echo "{\"delta\": $(frac "$1")$2}" ;;
    *) echo "{\"volume\": $(frac "$1")$2}" ;;
  esac
}

case ${1:-} in
  state) req "$URL/state" ;;
  scan) [[ ${2:-} == --cached ]] && req "$URL/scan?cached=1" || req "$URL/scan" ;;
  audio) req "$URL/audio" ;;
  events) req -N "$URL/events" ;;
  volume) check_percent "${2:-}"; post /audio/volume "$(volume_json "$2" "")" ;;
  mute) check_mute "${2:-}"; post /audio/mute "{\"muted\": $(mute_json "${2:-}")}" ;;
  mic-volume) check_percent "${2:-}"; post /audio/volume "$(volume_json "$2" ', "scope": "input"')" ;;
  mic-mute) check_mute "${2:-}"; post /audio/mute "{\"muted\": $(mute_json "${2:-}"), \"scope\": \"input\"}" ;;
  output|input) post "/audio/$1" "{\"uid\": \"${2:?device uid}\"}" ;;
  *) sed -n '2,9s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
